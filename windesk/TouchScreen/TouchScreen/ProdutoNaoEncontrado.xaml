<Window x:Class="Pag_Net.ProdutoNaoEncontrado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:k="clr-namespace:Pag_Net.Keyboard"
                Title="Produto Não Encontrado na Loja" Height="900" Width="1400" WindowState="Maximized" WindowStyle="ThreeDBorderWindow" HorizontalAlignment="Center" Loaded="Window_Loaded">
    <Grid x:Name="LayoutRoot" Margin="0" RenderTransformOrigin="0.517,0.522" HorizontalAlignment="Center" Width="1100" Height="800" >
        <Grid.RowDefinitions>
            <RowDefinition Height="113*"/>
            <RowDefinition Height="129*"/>
            <RowDefinition Height="448*"/>
            <RowDefinition Height="110*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="Tela.jpg"></ImageBrush>
        </Grid.Background>
        <Label HorizontalAlignment="Left"  Content="Informe o Produto"  FontSize="40" VerticalAlignment="Top" Height="68" Width="339" Margin="26,29,0,0" />
        <TextBox Grid.Row="1" Name="txtDigiteAqui"  
                 TextWrapping="Wrap" 
                 FontSize="56"
                 k:TouchScreenKeyboard.TouchScreenKeyboard="True" 
                 Background="Transparent" 
                 MaxLength="60" 
                 TabIndex="0" 
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 VerticalScrollBarVisibility="Visible" />
        <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,41" Width="1100" Height="401" 
              k:TouchScreenKeyboard.TouchScreenKeyboard="True" />
              
        <Grid Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="300,0,300,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button  Name="btnConfirma" VerticalAlignment="Bottom"  Height="100" Width="250" Click="btnConfirma_Click">
                <Image  Source="btnConfirma.png" Stretch="Fill" />
            </Button>
            <Button  Name="btnCorrige" Grid.Column="1" VerticalAlignment="Bottom" Height="100" Width="250"  HorizontalAlignment="Right"  Background="Transparent"  >
                <Image  Source="btnCorrige.png" Stretch="Fill" />
            </Button>
        </Grid>
    </Grid>
</Window>
