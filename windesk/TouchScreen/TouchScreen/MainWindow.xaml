<Window x:Class="Pag_Net.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Principal" Height="900" Width="1400" WindowState="Maximized" WindowStyle="ThreeDBorderWindow" HorizontalAlignment="Center"    >
    <Grid x:Name="LayoutRoot" Margin="0" RenderTransformOrigin="0.517,0.522" HorizontalAlignment="Center" Width="1400" >
        <Grid.RowDefinitions>
            <RowDefinition Height="99*" />
            <RowDefinition Height="327*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush  ImageSource="D:\Projects\p0050_MenuPagNetWPF\BIN\data\TouchScreenBackground.jpg"></ImageBrush>
        </Grid.Background>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                
            </Grid.ColumnDefinitions>


         <Button  Grid.Column="0" Name="btnElogio" Width="293" Height="310" Style="{StaticResource _ToucheScreenElogio}" Click="btnElogio_Click"></Button>
        <Button Grid.Column="1" Name="btnJornal" Width="293" Height="310" Style="{StaticResource _ToucheScreenJornal}" ></Button>
        <Button Grid.Column="2" Name="btnProdNaoEncontrado" Width="293" Height="310" Style="{StaticResource _ToucheScreenProdutoNaoEncontrado}" Click="btnProdNaoEncontrado_Click"></Button>
        </Grid>
    </Grid>
</Window>
