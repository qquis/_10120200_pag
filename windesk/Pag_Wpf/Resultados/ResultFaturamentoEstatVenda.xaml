<Page x:Class="Pag_Wpf.Resultados.ResultFaturamentoEstatVenda"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pag_Wpf"
             mc:Ignorable="d" 
             Title="Resultado - Faturamento/Estatística">
    <Grid Name="GridOperacionalProdutoVinculo" 
          Background="{StaticResource _BackGroundLinerGradientMain}" 
          Margin="0,0,0,0"  MaxWidth="900" Width="885" MinHeight="500" MaxHeight="600" >
        <ScrollViewer Visibility="Visible"   
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        Margin="0,0,0,0" 
        VerticalAlignment="Stretch" 
        HorizontalAlignment="Stretch" >
            <Grid  Margin="0,0,0,0" 
                   MaxWidth="{Binding ElementName=GridPagPgCadastroUsuario,Path=ActualWidth}" 
                   MaxHeight="{Binding ElementName=GridPagPgCadastroUsuario,Path=ActualHeight}"
                   >
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"></RowDefinition>
                    <RowDefinition Name="RowInfo" Height="92*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Name="GridCabec" Background="{x:Null}">
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0,0,0,4" Margin="0,0,0,10" BorderBrush="Blue" Grid.Row="0" Name="BorderTitulo" >
                        <Label Name="LabelTitulo" Content="Faturamento Operacional" FontSize="14" FontFamily="Gill Sans MT Condensed" Foreground="#FF1313D0" FontStretch="Condensed"></Label>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Name="GridInfo" HorizontalAlignment="Center" Background="{x:Null}" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Name="ColumnGridInfoList" Width="260"></ColumnDefinition>
                        <ColumnDefinition Name="ColumnGridInfoDados" Width="600"></ColumnDefinition>
                    </Grid.ColumnDefinitions>





                    <Grid Name="Gridfiltros" Grid.Column="0" Width="250"  VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="400"></RowDefinition>
                            
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Width="250" HorizontalAlignment="Left"  Background="#FFA7A2A2">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <Grid Name="dtgridStackPainelfiltros" Width="250" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource _LabelSubInfoPrincipal}" ></Label>
                            </Grid>
                        </StackPanel>
                        <StackPanel Name="StackPainelFiltros" Grid.Row="1"  Orientation="Horizontal" Margin="0,5,0,0" HorizontalAlignment="Left">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" ></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="25"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                    <ColumnDefinition Width="200"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Empresa</Label>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <ComboBox   VerticalAlignment="Stretch" ItemsSource="{Binding}"  HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="cmbEmpresa" Height="20" FontSize="9" Style="{StaticResource _ComboBoxDefault}" >
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DescricaoEmpresa}"  ></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label   FontSize="8" Style="{StaticResource _LabelDefault}">Data</Label>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45*"></ColumnDefinition>
                                            <ColumnDefinition Width="10*"></ColumnDefinition>
                                            <ColumnDefinition Width="45*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" Name="dtPickerCadIni" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}"  />
                                        <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                        <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" VerticalAlignment="Top" Name="dtPickerCadFim" Style="{StaticResource _DatePickerDefault}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Fabricante</Label>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <ComboBox FontSize="9" Height="20" ItemsSource="{Binding}" Name="cmbFabricante" Style="{StaticResource _ComboBoxDefault}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Name="DescricaoFabricante" Text="{Binding DescricaoFabricante}" Width="150" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>



                                <Border Grid.Row="3" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Vendedor</Label>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <ComboBox FontSize="9" Height="20" ItemsSource="{Binding}" Name="cmbVendedor" Style="{StaticResource _ComboBoxDefault}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Name="NomeVendedor" Text="{Binding NomeVendedor}" Width="150" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>




                                <Border Grid.Row="4" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Equipe</Label>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <ComboBox   VerticalAlignment="Stretch" ItemsSource="{Binding}"  HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="cmbEquipeVendas" Height="20" FontSize="9" Style="{StaticResource _ComboBoxDefault}" >
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Name="DescricaoEquipe" Text="{Binding DescricaoEquipe}"  ></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Área</Label>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <ComboBox   VerticalAlignment="Stretch" ItemsSource="{Binding}"  HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="cmbArea" Height="20" FontSize="9" Style="{StaticResource _ComboBoxDefault}" >
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Name="DescricaoArea" Text="{Binding DescricaoArea}"  ></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>

                                <Border Grid.Row="6" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Departamento</Label>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <ComboBox   VerticalAlignment="Stretch" ItemsSource="{Binding}"  HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="cmbDepartamento" Height="20" FontSize="9" Style="{StaticResource _ComboBoxDefault}" LostFocus="cmbDepartamento_LostFocus">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Name="DescricaoDepartamento" Text="{Binding DescricaoDepartamento}"  ></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>




                                <Border Grid.Row="7" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Seção</Label>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <ComboBox   VerticalAlignment="Stretch" ItemsSource="{Binding}"  HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="cmbSecao" Height="20" FontSize="9" Style="{StaticResource _ComboBoxDefault}" LostFocus="cmbSecao_LostFocus">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DescricaoSecao}"  ></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>

                                <Border Grid.Row="8" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Linha</Label>
                                </Border>
                                <Border Grid.Row="8" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <ComboBox   VerticalAlignment="Stretch" ItemsSource="{Binding}"  HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="cmbLinha" Height="20" FontSize="9" Style="{StaticResource _ComboBoxDefault}" >
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DescricaoLinha}"  ></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>


                                <Border Grid.Row="9" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label   FontSize="8" Style="{StaticResource _LabelDefault}">Vl. Total</Label>
                                </Border>
                                <Border Grid.Row="9" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45*"></ColumnDefinition>
                                            <ColumnDefinition Width="10*"></ColumnDefinition>
                                            <ColumnDefinition Width="45*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <TextBox  Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" Name="txtValorTotalIni" VerticalAlignment="Top" Style="{StaticResource _TextBoxDefault}"    />
                                        <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                        <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" VerticalAlignment="Top" Name="txtValorTotalFim" Style="{StaticResource _TextBoxDefault}"  />
                                    </Grid>
                                </Border>


                                <Border Grid.Row="10" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label   FontSize="8" Style="{StaticResource _LabelDefault}">Margem</Label>
                                </Border>
                                <Border Grid.Row="10" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45*"></ColumnDefinition>
                                            <ColumnDefinition Width="10*"></ColumnDefinition>
                                            <ColumnDefinition Width="45*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <TextBox  Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" Name="txtMargemIni" VerticalAlignment="Top" Style="{StaticResource _TextBoxDefault}"    />
                                        <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                        <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" VerticalAlignment="Top" Name="txtMargemFim" Style="{StaticResource _TextBoxDefault}"  />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="11" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Parametros</Label>
                                </Border>
                                <Border Grid.Row="11" Grid.Column="1" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"   VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="chkMargemItem" Height="20" FontSize="9" Content="Marg. Item" ></CheckBox>
                                        <CheckBox Grid.Column="1"   VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="chkEmbalagemFornecedor" Height="20" FontSize="9" Content="Emb Fornecedor" ></CheckBox>
                                    </Grid>
                                </Border>



                                <Border Grid.Row="12" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Cliente</Label>
                                </Border>
                                <Border Grid.Row="12" Grid.Column="1" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <TextBox   Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="txtFNomeCliente" Height="20" FontSize="9" Style="{StaticResource _TextBoxDefault}"  ></TextBox>
                                </Border>

                                <Border Grid.Row="13" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Produtos</Label>
                                </Border>
                                <Border Grid.Row="13" Grid.Column="1" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <TextBox    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="txtcodigoproduto"  Height="20" FontSize="9" Style="{StaticResource _TextBoxDefault}"  ></TextBox>
                                </Border>


                                <Border Grid.Row="14" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Desc. Prod</Label>
                                </Border>
                                <Border Grid.Row="14" Grid.Column="1" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                    <TextBox    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="txtdescricaoProduto"  Height="20" FontSize="9" Style="{StaticResource _TextBoxDefault}"  ></TextBox>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>


                    <Grid Name="GridList" Grid.Column="1" Width="600"  VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="370"></RowDefinition>
                            <RowDefinition Height="60"></RowDefinition>
                            
                            
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Width="600" HorizontalAlignment="Right"  Background="#FFA7A2A2">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <Grid Name="dtgridStackPainelTitulolista" Width="600" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Content="Dados do Faturamento" HorizontalAlignment="Left" Style="{StaticResource _LabelSubInfoPrincipal}" ></Label>
                                <Button Name="BtnBuscar" Margin="0,0,10,0" Grid.Column="13" HorizontalAlignment="Right"  Style="{StaticResource _ButtonStandard_Buscar}" Height="20" Width="20" Click="BtnBuscar_Click"></Button>
                                <Button Name="cmdtpPesquisaProduto" FontSize="8" Grid.Column="1" Click="TipoPesquisa_Click">Produto</Button>
                                <Button Name="cmdtpPesquisaFabricante" FontSize="8" Grid.Column="2" Click="TipoPesquisa_Click" HorizontalAlignment="Left" Width="36">Fabric</Button>
                                <Button Name="cmdtpPesquisaCliente" FontSize="8" Grid.Column="3" Click="TipoPesquisa_Click">Cliente</Button>
                                <Button Name="cmdtpPesquisaDepartamento" FontSize="8" Grid.Column="4" Click="TipoPesquisa_Click">Depart.</Button>
                                <Button Name="cmdtpPesquisaSecao" FontSize="8" Grid.Column="5" Click="TipoPesquisa_Click">Seção</Button>
                                <Button Name="cmdtpPesquisaLinha" FontSize="8" Grid.Column="6" Click="TipoPesquisa_Click">Linha</Button>
                                <Button Name="cmdtpPesquisaEquipe" FontSize="8" Grid.Column="7" Click="TipoPesquisa_Click">Equipe</Button>
                                <Button Name="cmdtpPesquisaVendedor" FontSize="8" Grid.Column="8" Click="TipoPesquisa_Click">Vend.</Button>
                                <Button Name="cmdtpPesquisaArea" FontSize="8" Grid.Column="9" Click="TipoPesquisa_Click">Área</Button>
                                <Button Name="cmdtpPesquisaEmpresa" FontSize="8" Grid.Column="10" Click="TipoPesquisa_Click">Empresa</Button>
                                <Button Name="cmdtpPesquisaData" FontSize="8" Grid.Column="11" Click="TipoPesquisa_Click" HorizontalAlignment="Left" Width="36">Data</Button>
                                <Button Name="cmdtpPesquisaPedidoCupom" FontSize="8" Grid.Column="12" Click="TipoPesquisa_Click">Pedido</Button>

                                
                            </Grid>
                        </StackPanel>
                        <StackPanel Name="StackPainelLista" 
                                    Grid.Row="1" 
                                    Orientation="Horizontal"
                                    HorizontalAlignment="center" 
                                    Margin="1,10,1,1"
                                    Width="600" MaxWidth="600"  Height="355">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <DataGrid Grid.Row="2" MaxWidth="600" MinWidth="600" HorizontalAlignment="Stretch" Language="Br-Pt"
                                      Name="DataGridFaturamentoOperacional" 
                                      BorderBrush="Black" 
                                      AutoGenerateColumns="False" 
                                      FontFamily="Gill Sans MT Condensed" 
                                      Foreground="Blue"
                                      RowBackground="{x:Null}" 
                                      FontSize="12" 
                                      VerticalScrollBarVisibility="Visible" 
                                      HorizontalScrollBarVisibility="Auto"
                                      Background="{x:Null}"
                                      IsReadOnly="False" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn FontSize="10" IsReadOnly="True" FontFamily="Bookman Old Style" Foreground="White"  Width="35" Header="Código"  Binding="{Binding CodigoInformacao}"></DataGridTextColumn>
                                    <DataGridTextColumn FontSize="10" IsReadOnly="True" FontFamily="Bookman Old Style" Foreground="White" Width="150" Header="Descricão" Binding="{Binding Descricao}"></DataGridTextColumn>
                                    <DataGridTextColumn FontSize="10" IsReadOnly="True" FontFamily="Bookman Old Style" Foreground="White" Width="35" Header="Pos" Binding="{Binding Pos}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn FontSize="10" IsReadOnly="True" FontFamily="Bookman Old Style" Foreground="White" Width="35" Header="Mix" Binding="{Binding Mix}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>                                        
                                    </DataGridTextColumn>
                                    
                                    
                                    <DataGridTextColumn FontSize="10" IsReadOnly="True" FontFamily="Bookman Old Style" Foreground="White" Width="55" Header="Vol" Binding="{Binding Volume, StringFormat={}{0:N1}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn FontSize="10" IsReadOnly="True" FontFamily="Bookman Old Style" Foreground="White" Width="70" Header="Venda" Binding="{Binding Venda, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn FontSize="10" IsReadOnly="True" FontFamily="Bookman Old Style" Foreground="White" Width="70" Header="Custo" Binding="{Binding Custo, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn FontSize="10" IsReadOnly="True" FontFamily="Bookman Old Style" Foreground="White" Width="40" Header="Margem" Binding="{Binding Margem, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn FontSize="10" IsReadOnly="True" FontFamily="Bookman Old Style" Foreground="White" Width="45" Header="Clientes" Binding="{Binding Clientes}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn FontSize="10" IsReadOnly="True" FontFamily="Bookman Old Style" Foreground="White" Width="40" Header="p%" Binding="{Binding Participacao, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                                <DataGrid.Resources>
                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                        <Setter Property="Background" Value="{StaticResource _BackGroundLinerGradientMain}"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Name="StackPainelFooterGrid" 
                                    Grid.Row="2" 
                                    Width="350"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right" 
                                    Margin="1,10,1,1" Background="#FFA7A2A2">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>

                            <Grid  >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition  Width="70" ></ColumnDefinition>
                                    <ColumnDefinition  Width="70"></ColumnDefinition>
                                    <ColumnDefinition  Width="70"></ColumnDefinition>
                                    <ColumnDefinition  Width="70"></ColumnDefinition>
                                    <ColumnDefinition  Width="70"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40*"></RowDefinition>
                                    <RowDefinition Height="60*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Grid.Column="0" Grid.Row="0" FontSize="8" VerticalAlignment="Top" Foreground="Blue" Background="{StaticResource _BackGroundLinerGradientMain}">Registros</Label>
                                <Label Grid.Column="1" Grid.Row="0" FontSize="8" VerticalAlignment="Top" Foreground="Blue" Background="{StaticResource _BackGroundLinerGradientMain}">Volume</Label>
                                <Label Grid.Column="2" Grid.Row="0" FontSize="8" VerticalAlignment="Top" Foreground="Blue" Background="{StaticResource _BackGroundLinerGradientMain}">Custo</Label>
                                <Label Grid.Column="3" Grid.Row="0" FontSize="8" VerticalAlignment="Top" Foreground="Blue" Background="{StaticResource _BackGroundLinerGradientMain}">Faturamento</Label>
                                <Label Grid.Column="4" Grid.Row="0" FontSize="8" VerticalAlignment="Top" Foreground="Blue" Background="{StaticResource _BackGroundLinerGradientMain}">Margem</Label>
                                <Label Grid.Column="0" Grid.Row="1" Name="LblRegistros"  BorderBrush="Black" BorderThickness="1" FontSize="8" HorizontalContentAlignment="Right"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="Black"></Label>
                                <Label Grid.Column="1" Grid.Row="1" Name="LblVolume" BorderBrush="Black" BorderThickness="1" FontSize="8" HorizontalContentAlignment="Right" VerticalContentAlignment="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="Black"></Label>
                                <Label Grid.Column="2" Grid.Row="1" Name="LblCusto" BorderBrush="Black" BorderThickness="1" FontSize="8" HorizontalContentAlignment="Right" VerticalContentAlignment="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="Black"></Label>
                                <Label Grid.Column="3" Grid.Row="1" Name="LblVenda" BorderBrush="Black" BorderThickness="1" FontSize="8" HorizontalContentAlignment="Right" VerticalContentAlignment="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="Black"></Label>
                                <Label Grid.Column="4" Grid.Row="1" Name="LblMargem" BorderBrush="Black" BorderThickness="1" FontSize="8" HorizontalContentAlignment="Right" VerticalContentAlignment="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="Black"></Label>
                            </Grid>

                        </StackPanel>
                        
                        
                    </Grid>
                    <Grid Name="GridLabels" Width="430" Grid.Column="1" VerticalAlignment="Top">
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
