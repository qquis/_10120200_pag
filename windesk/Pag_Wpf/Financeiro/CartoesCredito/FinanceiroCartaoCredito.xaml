<Page x:Class="Pag_Wpf.Financeiro.CartoesCredito.FinanceiroCartaoCredito"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
	Title="Log Sitef" >
    <Grid Name="GridCupomFiscal" 
          Background="{StaticResource _BackGroundLinerGradientMain}" 
          Margin="0,0,0,0"  MaxWidth="900" Width="885" MinHeight="500" MaxHeight="600" >
        <ScrollViewer Visibility="Visible"   
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        Margin="0,0,0,0" 
        VerticalAlignment="Stretch" 
        HorizontalAlignment="Stretch">
            <Grid  Margin="0,0,0,0" 
                   MaxWidth="{Binding ElementName=GridCupomFiscal,Path=ActualWidth}" 
                   MaxHeight="{Binding ElementName=GridCupomFiscal,Path=ActualHeight}"
                   >
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"></RowDefinition>
                    <RowDefinition Name="RowInfo" Height="92*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Name="GridCabec" Background="{x:Null}">
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0,0,0,4" Margin="0,0,0,10" BorderBrush="Blue" Grid.Row="0" Name="BorderTitulo" >
                        <Label Name="LabelTitulo" Content="Operações com Cartões de Crédito" FontSize="14" FontFamily="Gill Sans MT Condensed" Foreground="#FF1313D0" FontStretch="Condensed"></Label>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Name="GridInfo" HorizontalAlignment="Center" Background="{x:Null}" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Name="ColumnGridInfoList" Width="260"></ColumnDefinition>
                        <ColumnDefinition Name="ColumnGridInfoDados" Width="600"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid Name="Gridfiltros" Grid.Column="0" Width="250"  VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="180"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Width="250" HorizontalAlignment="Left"  Background="#FFA7A2A2">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <Grid Name="dtgridStackPainelfiltros" Width="250" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource _LabelSubInfoPrincipal}" ></Label>
                            </Grid>
                        </StackPanel>
                        <StackPanel Name="StackPainelFiltros" Grid.Row="1"  Orientation="Horizontal" Margin="0,5,0,0" HorizontalAlignment="Left">
                            <TabControl Background="{x:Null}" FontSize="9" >
                                <TabItem Background="{x:Null}" Header="Básicos" >
                                    <Grid >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25" ></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45"></ColumnDefinition>
                                            <ColumnDefinition Width="190"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Row="1" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40*"></ColumnDefinition>
                                                    <ColumnDefinition Width="30*"></ColumnDefinition>
                                                    <ColumnDefinition Width="30*"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Label   FontSize="8" Style="{StaticResource _LabelDefault}">Dt Mov</Label>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Label   FontSize="8" Style="{StaticResource _LabelDefault}">Dt Pgto</Label>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                    <ColumnDefinition Width="10*"></ColumnDefinition>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" Name="dtPickerMovimentoIni" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" />
                                                <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                                <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" VerticalAlignment="Top" Name="dtPickerMovimentoFim" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1"/>
                                            </Grid>
                                        </Border>


                                        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                    <ColumnDefinition Width="10*"></ColumnDefinition>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" Name="dtPickerPgtoIni" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" />
                                                <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                                <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" VerticalAlignment="Top" Name="dtPickerPgtoFim" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1"/>
                                            </Grid>
                                        </Border>

                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Grid>


                    <Grid Name="GridList" Grid.Column="1" Width="600"  VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="150"></RowDefinition>
                            <RowDefinition Height="150"></RowDefinition>
                            <RowDefinition Height="65"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Width="600" HorizontalAlignment="Right"  Background="#FFA7A2A2">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <Grid Name="dtgridStackPainelTitulolista" Width="600" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>


                                </Grid.ColumnDefinitions>
                                <Label Content="Log Sitef" HorizontalAlignment="Left" Style="{StaticResource _LabelSubInfoPrincipal}" ></Label>

                                <Button Name="BtnReport" Margin="0,0,0,0" Grid.Column="12" HorizontalAlignment="Stretch"  Style="{StaticResource _ButtonStandard_Imprimir}" Height="20" Width="20"  IsEnabled="False" Click="BtnReport_Click"></Button>
                                <Button Name="BtnBuscar" Margin="0,0,10,0" Grid.Column="13" HorizontalAlignment="Right"  Style="{StaticResource _ButtonStandard_Buscar}" Height="20" Width="20" Click="BtnBuscar_Click"></Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Name="StackPainelLista" 
                                    Orientation="Horizontal"
                                    HorizontalAlignment="center" 
                                    VerticalAlignment="Top"
                                    Margin="1,10,1,1"
                                    Width="600" MaxWidth="600"  Height="140">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <DataGrid MaxWidth="600" MinWidth="600" HorizontalAlignment="Stretch" Name="DataGridLogSitef" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn  IsReadOnly="True"  Width="25" Header="S" Binding="{Binding SeqSitefLog}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="35" Header="Origem" Binding="{Binding OrigemLancamento}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="35" Header="Fin." Binding="{Binding Finalizadora}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="75" Header="Produto" Binding="{Binding DescricaoProdutoFinanceiro}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="75" Header="Status" Binding="{Binding EstadoTransacao}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="90" Header="Doc" Binding="{Binding CartaoReferencia}"></DataGridTextColumn>

                                    <DataGridTextColumn IsReadOnly="True"  Width="45" Header="Emissão" Binding="{Binding DataEmissao, StringFormat=dd/MM/yyyy}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn  IsReadOnly="True"  Width="40" Header="Hora" Binding="{Binding DataHora, StringFormat=HH:mm:ss}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn  IsReadOnly="True"  Width="25" Header="ECF" Binding="{Binding Ecf}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn  IsReadOnly="True"  Width="45" Header="Cupom" Binding="{Binding CupomFiscal}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="55" Header="Valor" Binding="{Binding Valor, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>



                                    <DataGridTemplateColumn Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Name="cmdTransacaoRelacionada" Style="{StaticResource _ButtonStandard_Detalhes}" Height="10" Width="10" Click="cmdTransacaoRelacionada_Click"></Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Name="cmdImprimeTransacoes" Style="{StaticResource _ButtonStandard_Imprimir}" Height="10" Width="10" Click="cmdImprimeTransacoes_Click"></Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <TabControl Grid.Row="2" Background="{x:Null}" FontSize="9">
                            <TabItem Background="{x:Null}" Header="Transações associadas">
                                <DataGrid Grid.Column="1" Grid.Row="1" Name="DataGridTransacaoRelacionada" HorizontalAlignment="Stretch" Margin="3,7,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True"  Width="30" Header="Seq" Binding="{Binding SeqSitefLog}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn IsReadOnly="True"  Width="120" Header="Status" Binding="{Binding EstadoTransacao}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="120" Header="Doc" Binding="{Binding CartaoReferencia}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="80" Header="Hora" Binding="{Binding DataHora, StringFormat='HH:mm:ss'}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="50" Header="Valor" Binding="{Binding Valor, StringFormat={}{0:N2}}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                    <Grid Name="GridLabels" Width="430" Grid.Column="1" VerticalAlignment="Top">
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
