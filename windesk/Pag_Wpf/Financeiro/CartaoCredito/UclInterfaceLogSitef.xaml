<UserControl x:Class="Pag_Wpf.Financeiro.CartaoCredito.UclInterfaceLogSitef"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:DV="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"
             xmlns:DVC="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit" 
             xmlns:My="clr-namespace:Pag_Wpf.UserControls"
             mc:Ignorable="d" 
             Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Arquivo Log Sitef</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CmdImportarArquivo" Text="Importar Arquivo" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Incluir}" ImageClick="{StaticResource _ButtonImageBrush_Incluir_Click}" Click="CmdImportarArquivo_Click"></My:UclButton>
            <My:UclButton Grid.Column="2" x:Name="CmdBuscarInterfacesArquivos" Text="Imprimir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CmdBuscarInterfacesArquivos_Click"></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GRIDInfo" Style="{StaticResource UclGridInfo}"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="95*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>
                        <TabControl Grid.Row="1" Height="300" VerticalAlignment="Top" >
                            <TabItem Header="Básicos"  >
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30*"></ColumnDefinition>
                                        <ColumnDefinition Width="70*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0"  BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label   FontSize="12" Style="{StaticResource _LabelDefault}">Data Transação</Label>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Grid Margin="0,0,0,0"  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="10*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Name="dtPickerDataProcessamentoArquivoInicial" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" SelectedDateChanged="dtPickerDataProcessamentoArquivoInicial_SelectedDateChanged" />
                                            <Label Grid.Column="1"   FontSize="12" Style="{StaticResource _LabelDefault}">a</Label>
                                            <DatePicker Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Name="dtPickerDataProcessamentoArquivoFinal" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" SelectedDateChanged="dtPickerDataProcessamentoArquivoFinal_SelectedDateChanged" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>
            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" Name="DataGridSitefLogArquivos" ItemsSource="{Binding}" Height="150" >
                        <DataGrid.Columns>

                            <DataGridTextColumn IsReadOnly="True"  Width="25*" Header="Arquivo" Binding="{Binding Arquivo}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Data Transação" Binding="{Binding DataMovimento, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Ultimo Processamento" Binding="{Binding UltimoProcessamento, StringFormat=HH:mm:ss}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="25*" Header="Total de Registros" Binding="{Binding TotalRegistros, StringFormat={}{0:N0}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header=""  Width="5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="CmdLancamentos" Style="{StaticResource _ButtonStandard_Detalhes}" Height="10" Width="10" Click="CmdLancamentos_Click"></Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="cmdImprimeTransacoes" Style="{StaticResource _ButtonStandard_Imprimir}" Height="10" Width="10" ></Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusErro}" Value="True">
                                        <Setter Property="Foreground" Value="Red"></Setter>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                    <TabControl Grid.Row="2"  Height="200" MaxHeight="200" >
                        <TabItem Header="Registros Importados">
                            <DataGrid Grid.Row="2" Name="DataGridRegistos" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="Log Data" Binding="{Binding LogDataHora, StringFormat=dd/MM/yyyy HH:mm:ss}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="H.Tras" Binding="{Binding HoraTransacao, StringFormat=HH:mm:ss}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="Aut." Binding="{Binding Autorizador}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="Produto" Binding="{Binding CdProdutoFinanceiro}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="Trans." Binding="{Binding EstadoTransacao}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="N.Cartao" Binding="{Binding CartaoReferencia}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="Cod.Aut." Binding="{Binding CodigoAutorizacao}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="Origem" Binding="{Binding OrigemLancamento}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="L" Binding="{Binding Linha}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="Tipo" Binding="{Binding LogTipoTransacao}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="NSU" Binding="{Binding LogNSU}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="8*" Header="Valor" Binding="{Binding Valor, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                                <DataGrid.CellStyle>
                                    <Style TargetType="{x:Type DataGridCell}">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="Gray"/>
                                                <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding StatusErro}" Value="True">
                                                <Setter Property="Foreground" Value="Red"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusErro}" Value="False">
                                                <Setter Property="Foreground" Value="Black"></Setter>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                            </DataGrid>

                        </TabItem>


                    </TabControl>

                </Grid>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Name="GRIDR" Style="{StaticResource UclGridR}"  >
        </Grid>
    </Grid>
</UserControl>