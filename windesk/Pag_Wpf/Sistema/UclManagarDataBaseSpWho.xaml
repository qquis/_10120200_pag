<UserControl x:Class="Pag_Wpf.Sistema.UclManagarDataBaseSpWho"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:My="clr-namespace:Pag_Wpf.UserControls"
             
      mc:Ignorable="d" 
         Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"></ColumnDefinition>
                <ColumnDefinition Width="10*"></ColumnDefinition>
                <ColumnDefinition Width="10*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>


            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Data Base Manager - SP Who</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <RadioButton Grid.Row="0" Grid.Column="1" Content="ADM" Name="SRVADM" VerticalAlignment="Center" Click="SRVADM_Click"></RadioButton>
            <RadioButton Grid.Row="0" Grid.Column="2" Content="PRD" Name="SRVPRD" VerticalAlignment="Center" Click="SRVPRD_Click"></RadioButton>
            <My:UclButton Grid.Column="3" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CMDBuscar_Click"></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GridInfo" Style="{StaticResource UclGridInfo}" >
            <StackPanel Style="{StaticResource UclStackPainel}" >
                <DataGrid Name="DTGProcessos" Grid.Row="0"  HorizontalAlignment="Stretch" Height="300" >
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Sequencial" Binding="{Binding Spid}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="50*" Header="Login Name" Binding="{Binding LoginName}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Status" Binding="{Binding Status}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="40*" Header="Command" Binding="{Binding Command}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="HostName" Binding="{Binding HostName}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="BlkBy" Binding="{Binding BlkBy}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="DbName" Binding="{Binding DbName}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="CPUTime" Binding="{Binding CPUTime}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="DiskIo" Binding="{Binding DiskIo}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="LastBatch" Binding="{Binding LastBatch}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="ProgramName" Binding="{Binding ProgramName}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Request" Binding="{Binding ProgramName}"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>



    