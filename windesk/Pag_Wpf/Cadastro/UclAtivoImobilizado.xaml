<UserControl x:Class="Pag_Wpf.Cadastro.UclAtivoImobilizado"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:My="clr-namespace:Pag_Wpf.UserControls"
      mc:Ignorable="d" 
         Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Ativo Imobilizado</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CMDBuscar_Click"></My:UclButton>
            <My:UclButton Grid.Column="2" x:Name="CMDIncluir" Text="Incluir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Incluir}" ImageClick="{StaticResource _ButtonImageBrush_Incluir_Click}" Click="CMDIncluir_Click"></My:UclButton>
            <My:UclButton Grid.Column="3" x:Name="CMDReport" Text="Imprimir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Imprimir}"  ></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GridInfo" Style="{StaticResource UclGridInfo}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="95*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>


                        <TabControl Grid.Row="1" Height="350" VerticalAlignment="Top">
                            <TabItem Header="Básicos" >
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>

                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"></ColumnDefinition>
                                        <ColumnDefinition Width="180"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <CheckBox Name="CHKDataCadastro" Content="Cadastro" Click="CHKDataCadastro_Click"></CheckBox>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="10*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" HorizontalAlignment="Center" Name="DTPCAD_INI" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" SelectedDateChanged="DTPCAD_INI_SelectedDateChanged" />
                                            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                            <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Center" VerticalAlignment="Top" Name="DTPCAD_FIM" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1" SelectedDateChanged="DTPCAD_FIM_SelectedDateChanged" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0"   Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Empresa" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <ComboBox Grid.Column="1"   ItemsSource="{Binding}"   Margin="0,0,0,0"  Name="CMBEmpresa" Style="{StaticResource _ComboBoxDefault}" SelectionChanged="CMBEmpresa_SelectionChanged" >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock  Text="{Binding Descricao}" Width="150"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>

                                    <Border Grid.Row="2" Grid.Column="0"   Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Tipo" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <ComboBox Grid.Column="1"   ItemsSource="{Binding}"   Margin="0,0,0,0"  Name="CMBTipo" Style="{StaticResource _ComboBoxDefault}" SelectionChanged="CMBTipo_SelectionChanged"  >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock  Text="{Binding DescricaoTipo}" Width="100"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>

                                    <Border Grid.Row="3" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Descrição" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="TXTDESCRICAO" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right" TextChanged="TXTDESCRICAO_TextChanged" />
                                    </Border>



                                    <Border Grid.Row="4" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Componente" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <CheckBox Grid.Row="4" Grid.Column="1" Name="CHKComponente" Content="Exibir Ativo Tipo Componente"  Click="CHKComponente_Click"></CheckBox>

                                </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>

            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <DataGrid Name="DTGAtivoImobilizado" Grid.Row="0"  HorizontalAlignment="Stretch" Height="170" Margin="0,0,0,2" >
                        <DataGrid.Columns>
                            <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Código" Binding="{Binding SeqAtivoImobilizado}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Empresa" Binding="{Binding Empresa}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Descrição" Binding="{Binding Descricao}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Tipo" Binding="{Binding Tipo}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Cadastro" Binding="{Binding Cadastro, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn  Width="5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="CMDDetalhe" Style="{StaticResource _ButtonStandard_Detalhes}" Height="15" Width="15" Click="CMDDetalhe_Click" ></Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn  Width="5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="CMDAtivoEditar" Style="{StaticResource _ButtonStandard_Editar}" Height="15" Width="15" Click="CMDAtivoEditar_Click" ></Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Height="30" DataContext="{Binding ElementName=DTGAtivoImobilizado, Path=SelectedItem}">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*"></ColumnDefinition>
                                <ColumnDefinition Width="70*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <My:UclLabelText Grid.Row="0" Grid.Column="0" x:Name="UclLabelTextCodigo" Caption="Código" Text="{Binding Path=SeqAtivoImobilizado}"  UclLabelWidth="100" UclTextWidth="335"  ></My:UclLabelText>
                            <My:UclLabelText Grid.Row="0" Grid.Column="1" x:Name="UclLabelTextDescricao" Caption="Descrição" Text="{Binding Path=Descricao}"  UclLabelWidth="100" UclTextWidth="335" ></My:UclLabelText>
                        </Grid>
                    </StackPanel>

                    <TabControl Grid.Row="2" Height="200">
                        <TabItem Header="Conteúdo">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="113*"></ColumnDefinition>
                                    <ColumnDefinition Width="335*"/>
                                    <ColumnDefinition Width="448*"></ColumnDefinition>

                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <My:UclLabelText Grid.Row="0" Grid.Column="0" x:Name="UclLabelTextEmpresa" Caption="Empresa"  UclLabelWidth="100" UclTextWidth="300" Grid.ColumnSpan="2" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="1" Grid.Column="0" x:Name="UclLabelTextCadastro" Caption="Cadastro"  UclLabelWidth="100" UclTextWidth="300" Grid.ColumnSpan="2" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="2" Grid.Column="0" x:Name="UclLabelTextTipo" Caption="Tipo"  UclLabelWidth="100" UclTextWidth="300" Grid.ColumnSpan="2" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="3" Grid.Column="0" x:Name="UclLabelTextDataAquisicao" Caption="Aquisição"  UclLabelWidth="100" UclTextWidth="300" Grid.ColumnSpan="2" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="0" Grid.Column="2" x:Name="UclLabelTextDocumentoFiscal" Caption="Doc. Fiscal"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="1" Grid.Column="2" x:Name="UclLabelTextValorAquisicao" Caption="Valor Aquisição"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="2" Grid.Column="2" x:Name="UclLabelTextValorReposicao" Caption="Valor Reposição"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="3" Grid.Column="2" x:Name="UclLabelTextCodigoProduto" Caption="Ass. x Cd Prod"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="4" Grid.Column="2" x:Name="UclLabelTextCodigoBarra" Caption="Código de Barra"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                            </Grid>

                        </TabItem>
                        <TabItem Header="Componentes" IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95*"></ColumnDefinition>
                                    <ColumnDefinition Width="5*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <DataGrid Name="DTGAtivoImobilizadoComponente" Grid.Column="0" HorizontalAlignment="Stretch" Height="150" VerticalAlignment="Top" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Código" Binding="{Binding SeqAtivoImobilizado}"/>
                                        <DataGridTextColumn IsReadOnly="True"  Width="40*" Header="Descrição" Binding="{Binding Descricao}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Valor" Binding="{Binding Valor}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Valor Reposição" Binding="{Binding ValorReposicao}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Data Aquisição" Binding="{Binding DataAquisicao}"></DataGridTextColumn>
                                        <DataGridTemplateColumn  Width="5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Name="CMDAtivoEditarItem" Style="{StaticResource _ButtonStandard_Editar}" Height="15" Width="15" Click="CMDAtivoEditarItem_Click"  ></Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Button Name="CMDAtivoItemIncluir" Grid.Row="0"  Height="20" Width="20" Style="{StaticResource _ButtonStandard_Incluir}"  IsEnabled="True" ToolTip="Incluir" Click="CMDAtivoItemIncluir_Click"></Button>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Informações">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16*"/>
                                    <RowDefinition Height="27*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60*" ></ColumnDefinition>
                                    <ColumnDefinition Width="40*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <DataGrid Grid.Column="0" Name="DTGAtivoImobilizadoInformacoes"  HorizontalAlignment="Stretch" Height="150" VerticalAlignment="Top" Grid.RowSpan="2" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True"  Width="30*" Header="Informação" Binding="{Binding DescricaoTipoInformacao}"/>
                                        <DataGridTextColumn IsReadOnly="True"  Width="70*" Header="Descrição" Binding="{Binding Informacao}"></DataGridTextColumn>
                                        <DataGridTemplateColumn  Width="5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Name="CMDAtivoEditarInformacao" Style="{StaticResource _ButtonStandard_Editar}" Height="15" Width="15" Click="CMDAtivoEditarInformacao_Click"   ></Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Column="1" DataContext="{Binding ElementName=DTGAtivoImobilizadoInformacoes, Path=SelectedItem}" Grid.RowSpan="2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"></RowDefinition>
                                            <RowDefinition Height="120"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Label Content="Observação" Grid.Row="0" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                        <Label Name="LBLObservacao" Grid.Row="1" Height="120" Content="{Binding Path=Observacao}" Style="{StaticResource _LabelFormInfo}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </TabItem>



                    </TabControl>
                </Grid>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>

    