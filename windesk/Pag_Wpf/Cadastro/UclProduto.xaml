<UserControl x:Class="Pag_Wpf.Cadastro.UclProduto"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:My="clr-namespace:Pag_Wpf.UserControls"
             
      mc:Ignorable="d" 
         Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Produto</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CMDBuscar_Click"></My:UclButton>
            <My:UclButton Grid.Column="2" x:Name="CMDReport" Text="Imprimir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Imprimir}" ImageClick="{StaticResource _ButtonImageBrush_Imprimir_Click}"  ></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GridInfo" Style="{StaticResource UclGridInfo}" MaxWidth="900">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="95*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>


                        <TabControl Grid.Row="1" Height="350" VerticalAlignment="Top">
                            <TabItem Header="Básicos" >
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>

                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"></ColumnDefinition>
                                        <ColumnDefinition Width="180"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <CheckBox Name="CHKDataCadastro" Content="Cadastro" Click="CHKDataCadastro_Click"></CheckBox>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="10*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" HorizontalAlignment="Center" Name="DTPCAD_INI" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" SelectedDateChanged="DTPCAD_INI_SelectedDateChanged" />
                                            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                            <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Center" VerticalAlignment="Top" Name="DTPCAD_FIM" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1" SelectedDateChanged="DTPCAD_FIM_SelectedDateChanged" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0"   Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Departamento" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <ComboBox Grid.Column="1"   ItemsSource="{Binding}"   Margin="0,0,0,0"  Name="CMBDepartamento" Style="{StaticResource _ComboBoxDefault}" LostFocus="CMBDepartamento_LostFocus" SelectionChanged="CMBDepartamento_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock  Text="{Binding DescricaoDepartamento}" Width="100"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="0"   Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Seção" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <ComboBox Grid.Column="1"   ItemsSource="{Binding}"   Margin="0,0,0,0"  Name="CMBSecao" Style="{StaticResource _ComboBoxDefault}" LostFocus="CMBSecao_LostFocus">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DescricaoSecao}" Width="100"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="0"   Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Linha" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <ComboBox Grid.Column="1"   ItemsSource="{Binding}"   Margin="0,0,0,0"  Name="CMBLinha" Style="{StaticResource _ComboBoxDefault}" >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock  Text="{Binding DescricaoLinha}" Width="150"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>

                                    <Border Grid.Row="4" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Descrição" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="TXTDESCRICAO" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right" TextChanged="TXTDESCRICAO_TextChanged" />
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Códigos" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="TXTCODIGOS" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right" TextChanged="TXTCODIGOS_TextChanged" />
                                    </Border>
                                    <Border Grid.Row="6" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Status" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="6" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <CheckBox Name="CHKProdutosAtivos" FontSize="13" IsChecked="False"  VerticalAlignment="Center" Click="CHKProdutosAtivos_Click">Apenas Ativos</CheckBox>
                                    </Border>

                                    <Border Grid.Row="7" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Gestor" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="7" Grid.Column="1"  Margin="0,0,0,0" >
                                        <ComboBox Name="CMBProdutoGestor" Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="CMBProdutoGestor_SelectionChanged" >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Name="Descricao"  Text="{Binding Descricao}" Width="150" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>

                                    <Border Grid.Row="8" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Categoria" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="8" Grid.Column="1"  Margin="0,0,0,0" >
                                        <ComboBox Name="CMBCategoria" Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="CMBCategoria_SelectionChanged" >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Name="Descricao"  Text="{Binding Descricao}" Width="150" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>

            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}" >

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <DataGrid Name="DTGProdutos" Grid.Row="0"  HorizontalAlignment="Stretch" Height="170" Margin="0,0,0,2" >
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Código" Binding="{Binding CdProduto}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="45*" Header="Descrição" Binding="{Binding Descricao}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Emb." Binding="{Binding EmbalagemEstoque}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Cmp." Binding="{Binding EmbalagemCompra}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="CmpQ" Binding="{Binding EmbalagemCompraQtdeUnitaria}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Status" >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusProduto}" Value="True">
                                            <Setter Property="Text" Value="Ativo"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusProduto}" Value="False">
                                            <Setter Property="Text" Value="Inativo"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Cadastro" Binding="{Binding DataCadastro, StringFormat=dd/MM/yyyy}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Detalhes" Width="10*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Name="CMDDetalhe" Style="{StaticResource _ButtonStandard_Detalhes}" Height="15" Width="15" Click="CMDDetalhe_Click"></Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
                    <Grid Grid.Row="1" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <My:UclLabelText Grid.Row="0" Grid.Column="0" x:Name="UclLabelTextCodigo" Caption="Código Interno"  UclLabelWidth="100" UclTextWidth="335" ></My:UclLabelText>
                        <My:UclLabelText Grid.Row="0" Grid.Column="1" x:Name="UclLabelTextDescricao" Caption="Descrição"  UclLabelWidth="100" UclTextWidth="335" ></My:UclLabelText>
                    </Grid>
                    <TabControl Grid.Row="2" Height="200">
                    <TabItem Header="Conteúdo">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>

                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>


                                
                                <Grid Grid.Row="0"  HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90*"></ColumnDefinition>
                                        <ColumnDefinition Width="10*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                <My:UclLabelText Grid.Column="0" x:Name="UclLabelTextCategoria" Caption="Categoria"  UclLabelWidth="100" UclTextWidth="265" ></My:UclLabelText>
                                    <My:UclButton Grid.Column="1" x:Name="CMDProdutoCategoriaEditar"  Height="30"  UclButtonMaxWidth="100"    ImageNoClick="{StaticResource _ButtonImageBrush_Editar}" ImageClick="{StaticResource _ButtonImageBrush_Editar_Click}" Click="CMDProdutoCategoriaEditar_Click" ></My:UclButton>
                                </Grid>


                                <Grid Grid.Row="1"  HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90*"></ColumnDefinition>
                                        <ColumnDefinition Width="10*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <My:UclLabelText Grid.Row="1" Grid.Column="0" x:Name="UclLabelTextLinha" Caption="Linha"  UclLabelWidth="100" UclTextWidth="265" ></My:UclLabelText>
                                    <My:UclButton Grid.Column="1" x:Name="CMDLinhaEditar"  Height="30"  UclButtonMaxWidth="100"    ImageNoClick="{StaticResource _ButtonImageBrush_Editar}" ImageClick="{StaticResource _ButtonImageBrush_Editar_Click}" Click="CMDLinhaEditar_Click" ></My:UclButton>
                                </Grid>

                                
                                <My:UclLabelText Grid.Row="2" Grid.Column="0" x:Name="UclLabelTextSecao" Caption="Seção"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="3" Grid.Column="0" x:Name="UclLabelTextDepartamento" Caption="Departamento"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>

                                <My:UclLabelText Grid.Row="0" Grid.Column="1" x:Name="UclLabelTextEmbalagemEstoque" Caption="Emb. Estoque"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="1" Grid.Column="1" x:Name="UclLabelTextEmbalagemCompra" Caption="Emb. Compra"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="2" Grid.Column="1" x:Name="UclLabelTextEmbalagemCompraQtdeUnitaria" Caption="Q. Unit Cmp"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                                


                                <Grid Grid.Row="3" Grid.Column="1"  HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90*"></ColumnDefinition>
                                        <ColumnDefinition Width="10*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <My:UclLabelText Grid.Column="0" x:Name="UclLabelTextGestor" Caption="Gestor"  UclLabelWidth="100" UclTextWidth="265" ></My:UclLabelText>
                                    <My:UclButton Grid.Column="1" x:Name="CMDGestorEditar"  Height="30"  UclButtonMaxWidth="100"    ImageNoClick="{StaticResource _ButtonImageBrush_Editar}" ImageClick="{StaticResource _ButtonImageBrush_Editar_Click}" Click="CMDGestorEditar_Click"></My:UclButton>
                                </Grid>



                            </Grid>

                        </TabItem>
                    <TabItem Header="Embalagens" IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*"></ColumnDefinition>
                                    <ColumnDefinition Width="50*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <DataGrid Name="DTGProdutosEmbalagens" Grid.Column="0" HorizontalAlignment="Stretch" Height="150" VerticalAlignment="Top" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Embalagem" Binding="{Binding Embalagem}"/>
                                        <DataGridTextColumn IsReadOnly="True"  Width="40*" Header="Descrição" Binding="{Binding EmbalagemDescricao}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Relação" Binding="{Binding Relacao}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Fator" Binding="{Binding FatorEstoque}"></DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid Name="DTGProdutosEmbalagensCodigoBarra" Grid.Column="1" Margin="4,1,1,1" HorizontalAlignment="Stretch" Height="150" VerticalAlignment="Top" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Emb." Binding="{Binding Embalagem}"/>
                                        <DataGridTextColumn IsReadOnly="True"  Width="40*" Header="Código de Barra" Binding="{Binding CodigoBarra}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="40*" Header="Tipo" Binding="{Binding TipoCodigoBarra}"></DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        
                        
                        

                        </TabItem>

                </TabControl>
                </Grid>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
