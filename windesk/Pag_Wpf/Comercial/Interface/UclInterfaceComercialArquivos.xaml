<UserControl x:Class="Pag_Wpf.Comercial.Interface.UclInterfaceComercialArquivos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:DV="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"
             xmlns:DVC="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit" 
             xmlns:My="clr-namespace:Pag_Wpf.UserControls"
             mc:Ignorable="d" 
             Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Arquivos</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="2" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CMDBuscar_Click"></My:UclButton>

        </Grid>
        <Grid Grid.Row="1" Name="GRIDInfo" Style="{StaticResource UclGridInfo}"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="65*"></ColumnDefinition>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>
                        <TabControl Grid.Row="1" Height="300" VerticalAlignment="Top">
                            <TabItem Header="Processamento">
                                <Grid Width="330" Height="330">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"></RowDefinition>
                                        <RowDefinition Height="30"></RowDefinition>
                                        <RowDefinition Height="30"></RowDefinition>
                                        <RowDefinition Height="30"></RowDefinition>
                                        <RowDefinition Height="30"></RowDefinition>
                                        <RowDefinition Height="150"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Style="{StaticResource _LabelFormInfo}">Interface</Label>

                                    <ComboBox Grid.Row="1"   ItemsSource="{Binding}"   Margin="2,2,2,2"  Name="CMBInterfaceInfo" Style="{StaticResource _ComboBoxDefault}" SelectionChanged="CMBInterfaceInfo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock  Text="{Binding Descricao}" Width="100"  ></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>



                                    <Label Grid.Row="2" Style="{StaticResource _LabelFormInfo}">Geração</Label>
                                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,0"  >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45*"></ColumnDefinition>
                                            <ColumnDefinition Width="10*"></ColumnDefinition>
                                            <ColumnDefinition Width="45*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker Grid.Row="0" Grid.Column="0" Height="25"  Width="120" Name="dtPickerCadIni" VerticalAlignment="Center"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" SelectedDateChanged="dtPickerCadIni_SelectedDateChanged" />
                                        <Label Grid.Row="0" Grid.Column="1" FontSize="11" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                        <DatePicker Grid.Row="0" Grid.Column="2" Height="25" Width="120" VerticalAlignment="Center" Name="dtPickerCadFim" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1" SelectedDateChanged="dtPickerCadFim_SelectedDateChanged" />
                                    </Grid>

                                    <Label Grid.Row="4" Style="{StaticResource _LabelFormInfo}">Arquivos Enviados</Label>
                                    <DataGrid Grid.Row="5" Name="DTGInterfaceArquivos"  HorizontalAlignment="Stretch" Height="120" VerticalAlignment="Top">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn IsReadOnly="True"  Width="40*" Header="Arquivo" Binding="{Binding DescricaoTipoArquivo}"/>
                                            <DataGridTextColumn IsReadOnly="True"  Width="50*" Header="Proc Db" Binding="{Binding DbProcedure}"/>
                                            <DataGridTemplateColumn Header="Detalhes">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Name="CMDArquivoDetalhes" Style="{StaticResource _ButtonStandard_Detalhes}" Height="10" Width="10" Click="CMDArquivoDetalhes_Click" ></Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>


                        </TabControl>


                    </Grid>
                </StackPanel>
            </Expander>
            <StackPanel Grid.Column="2"  Style="{StaticResource UclStackPainel}" Grid.ColumnSpan="2" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="350"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Height="350">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="210"></RowDefinition>
                            <RowDefinition Height="135"></RowDefinition>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" Name="DTGInterfaceComercialArquivos" Height="210"    VerticalAlignment="Top" >
                            <DataGrid.Columns>
                                <DataGridTextColumn IsReadOnly="True"  Width="7*" Header="Seq" Binding="{Binding SeqArquivoHistorico}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="7*" Header="Tipo" Binding="{Binding DescricaoTipoArquivo}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="7*" Header="Nome" Binding="{Binding NomeArquivo}"></DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="7*" Header="Path" Binding="{Binding PathArquivo}"></DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="7*" Header="Geração" Binding="{Binding DataGeracao, StringFormat=dd/MM/yyyy}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="7*" Header="Envio" Binding="{Binding DataEnvio, StringFormat=dd/MM/yyyy}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="7*" Header="Confirmação" Binding="{Binding DataConfirmacao, StringFormat=dd/MM/yyyy}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Name="CMDArquivoHistoricoDetalhes" Style="{StaticResource _ButtonStandard_Detalhes}" Height="10" Width="10" Click="CMDArquivoHistoricoDetalhes_Click"  ></Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Name="CMDArquivoGerar" Style="{StaticResource  _ButtonStandard_SelecionaTudo}" Height="10" Width="10" Click="CMDArquivoGerar_Click"   ></Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" ></ColumnDefinition>
                                <ColumnDefinition Width="70*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <DataGrid Grid.Column="0" Name="DTGInterfaceComercialArquivosLinhas" Height="135"    VerticalAlignment="Top" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Linha" Binding="{Binding SeqLinha}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="80*" Header="Linha" Binding="{Binding Linha}"></DataGridTextColumn>
                                
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Column="1" HorizontalAlignment="Stretch" Height="150" VerticalAlignment="Top" DataContext="{Binding ElementName=DTGInterfaceComercialArquivosLinhas, Path=SelectedItem}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"></RowDefinition>
                                    <RowDefinition Height="100"></RowDefinition>
                                </Grid.RowDefinitions>
                            <Label Grid.Row="0" Style="{StaticResource _LabelFormInfo}">Conteudo</Label>
                                
                                <TextBox Grid.Row="1" Name="TXTLinhaConteudo" Text="{Binding Path=Linha}" Height="100" VerticalAlignment="Center" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" MaxLength="0" TextWrapping="Wrap"></TextBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Name="GRIDFolter" Style="{StaticResource UclGridR}">
        </Grid>
    </Grid>
</UserControl>