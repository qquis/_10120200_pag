<UserControl x:Class="Pag_Wpf.Comercial.Interface.UclInterfaceComercialFaturamentoSimulado"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:My="clr-namespace:Pag_Wpf.UserControls"
      mc:Ignorable="d" 
         Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Interface - Faturamento Simulado</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CMDBuscar_Click"></My:UclButton>
            <My:UclButton Grid.Column="2" x:Name="CMDIncluir" Text="Incluir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Incluir}" ImageClick="{StaticResource _ButtonImageBrush_Incluir_Click}" Click="CMDIncluir_Click"/>
            <My:UclButton Grid.Column="3" x:Name="CMDReport" Text="Imprimir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Imprimir}"  ></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GridInfo" Style="{StaticResource UclGridInfo}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="95*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>


                        <TabControl Grid.Row="1" Height="350" VerticalAlignment="Top">
                            <TabItem Header="Básicos" >
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>

                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"></ColumnDefinition>
                                        <ColumnDefinition Width="180"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Data" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="10*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" HorizontalAlignment="Center" Name="DTPCAD_INI" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" SelectedDateChanged="DTPCAD_INI_SelectedDateChanged" />
                                            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                            <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Center" VerticalAlignment="Top" Name="DTPCAD_FIM" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1" SelectedDateChanged="DTPCAD_FIM_SelectedDateChanged" />
                                        </Grid>
                                    </Border>



                                    <Border Grid.Row="0" Grid.Column="0"   Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Interface" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <ComboBox Grid.Column="1"   ItemsSource="{Binding}"   Margin="0,0,0,0"  Name="CMBInterface" Style="{StaticResource _ComboBoxDefault}" SelectionChanged="CMBInterface_SelectionChanged" >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock  Text="{Binding Descricao}" Width="150"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>


                                    <Border Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Produtos" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="TXTPRODUTOS" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right" SelectionChanged="TXTPRODUTOS_SelectionChanged" PreviewMouseDoubleClick="TXTPRODUTOS_PreviewMouseDoubleClick" />
                                    </Border>


                                </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>

            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*"></RowDefinition>
                        <RowDefinition Height="347*"/>
                        <RowDefinition Height="30*"/>


                    </Grid.RowDefinitions>
                    <DataGrid Name="DTGInterfaceFaturamentoClientesNaoFaturados" Grid.Row="0"  HorizontalAlignment="Stretch" Height="350" Margin="0,0,0,2" Grid.RowSpan="2" >
                        <DataGrid.Columns>
                            <DataGridTextColumn IsReadOnly="True"  Width="3*" Header="SeqInterfaceInfo" Binding="{Binding SeqInterfaceInfo}"   >
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Data Fat." Binding="{Binding DataFaturamento, StringFormat=dd/MM/yyyy}"   >
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Vendedor" Binding="{Binding CdVendedorERP}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Nome" Binding="{Binding NomeParticipanteVendedor}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Cliente" Binding="{Binding CdClienteERP}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="25*" Header="Nome" Binding="{Binding NomeParticipanteCliente}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Prod" Binding="{Binding CdProduto}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Descrição" Binding="{Binding Descricao}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="3*" Header="UN" Binding="{Binding EmbalagemEstoque}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Qtde" Binding="{Binding EmbalagemEstoqueQtde}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Valor" Binding="{Binding ValorTotalFaturamento}"></DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Height="30" DataContext="{Binding ElementName=DTGContratos, Path=SelectedItem}">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*"></ColumnDefinition>
                                <ColumnDefinition Width="70*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <My:UclLabelText Grid.Row="0" Grid.Column="0" x:Name="UclLabelTotalRegistros" Caption="Total de Registros" Text="{Binding Path=SeqContrato}"  UclLabelWidth="150" UclTextWidth="100"  ></My:UclLabelText>

                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>