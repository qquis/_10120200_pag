                                            <Label Grid.Row="3" Grid.Column="3"  Content="{Binding Path=M3EmbalagemCompraQtde, StringFormat={}{0:N2}}" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                            <Label Grid.Row="4" Grid.Column="3"  Content="{Binding Path=M4EmbalagemCompraQtde, StringFormat={}{0:N2}}"  Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
