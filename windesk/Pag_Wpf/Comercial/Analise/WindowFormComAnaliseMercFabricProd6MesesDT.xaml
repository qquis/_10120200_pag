                                            <Label Grid.Column="3" Grid.Row="0"   Content="Cmp" FontSize="10" BorderThickness="0,0,0,1"  BorderBrush="White"  Foreground="White" ></Label>
                                            <Label Grid.Column="1" Grid.Row="0"   Content="R$" FontSize="10" BorderThickness="0,0,0,1"  BorderBrush="White"  Foreground="White" ></Label>
                                                
