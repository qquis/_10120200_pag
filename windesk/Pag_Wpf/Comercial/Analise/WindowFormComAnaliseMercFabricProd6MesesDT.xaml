                                            <Label Grid.Row="2" Grid.Column="1" Name="LBLFABRICANTEMESCUSTO" Content="{Binding Path=MesCusto, StringFormat={}{0:N2}}" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                            <Label Grid.Row="3" Grid.Column="1" Name="LBLFABRICANTEMESMARGEM" Content="{Binding Path=MesMargem, StringFormat={}{0:N2}}" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
