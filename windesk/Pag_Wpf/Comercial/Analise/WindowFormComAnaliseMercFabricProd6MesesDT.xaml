                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="60" Header="MsCt" Binding="{Binding MesCusto, StringFormat={}{0:N2}}">
