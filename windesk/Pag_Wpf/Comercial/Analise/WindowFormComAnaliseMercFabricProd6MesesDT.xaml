                                        <Label Grid.Row="2" Grid.Column="1" Name="LBLMES2VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                        <Label Grid.Row="3" Grid.Column="1" Name="LBLMES3VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                        <Label Grid.Row="4" Grid.Column="1" Name="LBLMES4VALOR"  Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                        <Label Grid.Row="5" Grid.Column="1" Name="LBLMES5VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                        <Label Grid.Row="6" Grid.Column="1" Name="LBLMES6VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"   HorizontalContentAlignment="Right"/>
                                        <Label Grid.Row="7" Grid.Column="1" Name="LBLMES7VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"   HorizontalContentAlignment="Right"/>
                                    </Grid>
                                        <Grid Grid.Column="1" >
