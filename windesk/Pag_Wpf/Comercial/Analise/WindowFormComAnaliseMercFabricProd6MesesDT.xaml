                                            <Label Grid.Row="0" Grid.Column="1" Content="Mensal" FontSize="10" BorderThickness="0,0,0,1"  BorderBrush="White"  Foreground="White" ></Label>
                                            <Label Grid.Row="0" Grid.Column="2" Content="Média" FontSize="10" BorderThickness="0,0,0,1"  BorderBrush="White"  Foreground="White" ></Label>
