<UserControl x:Class="Pag_Wpf.Comercial.Analise.UclComAnaliseMercFabricProd6Meses"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:DVC="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit" 
        xmlns:My="clr-namespace:Pag_Wpf.UserControls"
             
      mc:Ignorable="d" 
         Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" Content="Análise Comercial - Fabricante x Produto" />
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="2" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CMDBuscar_Click"  />

        </Grid>
        <Grid Grid.Row="1" Name="GridInfo" Style="{StaticResource UclGridInfo}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="95*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>
                        <TabControl Grid.Row="1" Height="350" VerticalAlignment="Top">
                            <TabItem Header="Básicos" >
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"></ColumnDefinition>
                                        <ColumnDefinition Width="280"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                 

                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label  Content="Operação" Style="{StaticResource _LabelFormInfo}" HorizontalContentAlignment="Left" ></Label>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="1,1,1,1" BorderThickness="1,1,1,1" BorderBrush="Silver" >
                                        <ComboBox  ItemsSource="{Binding}" Name="CMBOperacao" Style="{StaticResource _ComboBoxDefault}" SelectionChanged="CMBOperacao_SelectionChanged"  >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DescricaoOperacao}"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>

            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}" Width="900">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200"></RowDefinition>
                        <RowDefinition Height="250"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" Name="DTGAnaliseComercialFabricanteProduto"  >
                        <DataGrid.Columns>
                            <DataGridTextColumn IsReadOnly="True"  Width="110" Header="Descrição" Binding="{Binding DescricaoFabricante}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="M1" Binding="{Binding M1Valor, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="M2" Binding="{Binding M2Valor, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="M3" Binding="{Binding M3Valor, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="M4" Binding="{Binding M4Valor, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="M5" Binding="{Binding M5Valor, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="M6" Binding="{Binding M6Valor, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="Compras - Mes" Binding="{Binding M7Valor, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="MsCt" Binding="{Binding MesCusto, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>


                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="MdCusto" Binding="{Binding MediaCusto, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>



                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="Estoque" Binding="{Binding ValorEstoque, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>


                            <DataGridTextColumn IsReadOnly="True"  Width="30" Header="IC" Binding="{Binding IndiceCorrente, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn IsReadOnly="True"  Width="30" Header="IM" Binding="{Binding IndiceMedio, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>



                            <DataGridTemplateColumn Width="20">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="CMDDetalhes" Style="{StaticResource _ButtonStandard_Detalhes}" Height="15" Width="15" Click="CMDDetalhes_Click" ></Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70*"></ColumnDefinition>
                                <ColumnDefinition Width="30*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <DVC:Chart  Name="MCTotal" FontSize="8" Foreground="Black"  HorizontalAlignment="Stretch"  Background="LightBlue" Height="150"  MaxHeight="200">
                                <DVC:Chart.Series>
                                    <DVC:ColumnSeries Name="CmFabricante" Title="Compras" FontSize="8" 
                                                       Foreground="Blue" 
                                                      IndependentValueBinding="{Binding Path=Key}" 
                                                      DependentValueBinding="{Binding Path=Value}" 
                                                      ItemsSource="{Binding [0]}" 
                                                      IsSelectionEnabled="True">


                                    </DVC:ColumnSeries>
                                </DVC:Chart.Series>
                            </DVC:Chart>
                            <Grid Grid.Column="1" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="23"/>
                                    <RowDefinition Height="23"/>
                                    <RowDefinition Height="23"/>
                                    <RowDefinition Height="23"/>
                                    <RowDefinition Height="23"/>
                                    <RowDefinition Height="23"/>
                                    <RowDefinition Height="23"/>
                                    <RowDefinition Height="23"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60*"></ColumnDefinition>
                                    <ColumnDefinition Width="40*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Width="190"  Content="Valor de Compras Fabricante" FontSize="10" BorderThickness="0,0,0,1"  BorderBrush="White" HorizontalAlignment="Center"  Foreground="White" ></Label>
                                <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1" Content="Mes 1"/>
                                <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1" Content="Mes 2"/>
                                <Label Grid.Row="3" Grid.Column="0" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1" Content="Mes 3"/>
                                <Label Grid.Row="4" Grid.Column="0" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1" Content="Mes 4"/>
                                <Label Grid.Row="5" Grid.Column="0" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1" Content="Mes 5"/>
                                <Label Grid.Row="6" Grid.Column="0" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1" Content="Mes 6"/>
                                <Label Grid.Row="7" Grid.Column="0" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1" Content="Mês Atual"/>
                                <Label Grid.Row="1" Grid.Column="1" Name="LBLMES1VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                <Label Grid.Row="2" Grid.Column="1" Name="LBLMES2VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                <Label Grid.Row="3" Grid.Column="1" Name="LBLMES3VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                <Label Grid.Row="4" Grid.Column="1" Name="LBLMES4VALOR"  Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                <Label Grid.Row="5" Grid.Column="1" Name="LBLMES5VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"  HorizontalContentAlignment="Right"/>
                                <Label Grid.Row="6" Grid.Column="1" Name="LBLMES6VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"   HorizontalContentAlignment="Right"/>
                                <Label Grid.Row="7" Grid.Column="1" Name="LBLMES7VALOR" Style="{StaticResource _LabelFormInfo}" Margin="1,1,1,1"   HorizontalContentAlignment="Right"/>
                            </Grid>
                        </Grid>

                    </StackPanel>



                </Grid>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
