<Window x:Class="Pag_Wpf.Comercial.RepresentantesComerciais.Representantes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Representante" Height="200" Width="400">
    <Grid Background="DimGray" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"></RowDefinition>
                <RowDefinition Height="80*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80*"></ColumnDefinition>
                    <ColumnDefinition Width="15*"></ColumnDefinition>
                    <ColumnDefinition Width="15*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label  Grid.Column="0" Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Blue" FontSize="14" Content="Cadastrando Novo Representante" VerticalContentAlignment="Center"  Foreground="White"></Label>
                <Label  Grid.Column="1" Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Blue" FontSize="14" Content="Efetivar" Foreground="White" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" ></Label>
                <Label  Grid.Column="2" Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Blue" ></Label>
                <Button Grid.Column="2" Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Blue" Name="cmdEfetivar" HorizontalAlignment="Left"  Style="{StaticResource _ButtonStandard_Efetivar}" Click="cmdEfetivar_Click"></Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"></RowDefinition>
                        <RowDefinition Height="40"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0"   Margin="5,5,5,5" Content="Nome" Style="{StaticResource _LabelFormInfo}" VerticalContentAlignment="Center"  FontSize="14"></Label>
                    <TextBox Grid.Row="1" Margin="5,-10,5,0" Name="TXTDESCRICAO" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Left"  VerticalContentAlignment="Center"  TextChanged="TXTDESCRICAO_TextChanged" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

    