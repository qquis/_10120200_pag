<Window x:Class="Pag_Wpf.Comercial.RepresentantesComerciais.RepresentanteParticipantes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RepresentanteParticipante" Height="300" Width="600">
    <Grid Background="DimGray" >
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"></RowDefinition>
                <RowDefinition Height="80*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"></ColumnDefinition>
                    <ColumnDefinition Width="15*"></ColumnDefinition>
                    <ColumnDefinition Width="15*"></ColumnDefinition>
                    <ColumnDefinition Width="15*"></ColumnDefinition>
                    <ColumnDefinition Width="15*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label  Grid.Column="0" Grid.Row="0" Content="Associação Representante X Participante" VerticalContentAlignment="Center" Foreground="White" BorderThickness="0,0,0,3" BorderBrush="Blue" FontSize="14" ></Label>
                <Label  Grid.Column="1" Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Blue" ></Label>
                <Label  Grid.Column="2" Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Blue" ></Label>
                <Label  Grid.Column="4" Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Blue" ></Label>
                <Label  Grid.Column="3" Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Blue" Content="Efetivar" Foreground="White" FontSize="14" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" ></Label>
                <Button Grid.Column="4" Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Blue" Name="cmdEfetivar" HorizontalAlignment="Left"  Style="{StaticResource _ButtonStandard_Efetivar}" Click="cmdEfetivar_Click"></Button>
            </Grid>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" DataContext="{Binding ElementName=DTGParticipante, Path=SelectedItem}">
                    <Grid Grid.Column="0" Width="280"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,25,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="30"></RowDefinition>
                        
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40*"></ColumnDefinition>
                            <ColumnDefinition Width="80*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Representante" Style="{StaticResource _LabelFormInfo}" VerticalContentAlignment="Center" FontSize="12"></Label>
                        <Label Grid.Row="1" Grid.Column="0" Name="LBLREPRESENTANTESELECIONADO_CODIGO"   Style="{StaticResource _LabelFormInfo}" VerticalContentAlignment="Center"  FontSize="12"></Label>
                        <Label Grid.Row="0" Grid.Column="1" Content="Nome" Style="{StaticResource _LabelFormInfo}" VerticalContentAlignment="Center"  FontSize="12"></Label>
                        <Label Grid.Row="1" Grid.Column="1" Name="LBLREPRESENTANTESELECIONADO_NOME"  Style="{StaticResource _LabelFormInfo}" VerticalContentAlignment="Center"  FontSize="12"></Label>

                        <Label Grid.Row="3" Grid.Column="0" Content="Participante" Style="{StaticResource _LabelFormInfo}" VerticalContentAlignment="Center"  FontSize="12"></Label>
                        <Label Grid.Row="4" Grid.Column="0" Name="LBLPARTICIPANTESELECIONADO_CODIGO"  Content="{Binding Path=CdParticipante}" VerticalContentAlignment="Center"   Style="{StaticResource _LabelFormInfo}" FontSize="12"></Label>
                        <Label Grid.Row="3" Grid.Column="1" Content="Nome" Style="{StaticResource _LabelFormInfo}" VerticalContentAlignment="Center"  FontSize="12"></Label>
                        <Label Grid.Row="4" Grid.Column="1" Name="LBLPARTICIPANTESELECIONADO_DESCRICAO" Content="{Binding Path=Nome}" VerticalContentAlignment="Center"  Style="{StaticResource _LabelFormInfo}" FontSize="12"></Label>
                        <Label Grid.Row="5" Grid.Column="0" Content="CNPJ" Style="{StaticResource _LabelFormInfo}" VerticalContentAlignment="Center"  FontSize="12"></Label>
                        <Label Grid.Row="5" Grid.Column="1" Name="LBLPARTICIPANTESELECIONADO_DOCUMENTO" Content="{Binding Path=CNPJ}" Style="{StaticResource _LabelFormInfo}" VerticalContentAlignment="Center"  FontSize="12"></Label>
                    </Grid>
                </StackPanel>
                <DataGrid Grid.Column="1" Name="DTGParticipante" Margin="10,25,10,10" Height="180" VerticalAlignment="Top" >
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True"  Width="50" Header="Codigo" Binding="{Binding CdParticipante}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="110" Header="Nome" Binding="{Binding Nome}"></DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="110" Header="Cnpj" Binding="{Binding CNPJ}"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        
        
    </Grid>
</Window>

    