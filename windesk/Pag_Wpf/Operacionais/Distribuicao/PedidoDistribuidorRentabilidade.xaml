<Page x:Class="Pag_Wpf.Operacionais.PedidoDistribuidorRentabilidade"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
	Title="Cupom Fiscal">
    <Grid Name="GridCupomFiscal" 
          Background="{StaticResource _BackGroundLinerGradientMain}" 
          Margin="0,0,0,0"  MaxWidth="900" Width="885" MinHeight="500" MaxHeight="600" >
        <ScrollViewer Visibility="Visible"   
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        Margin="0,0,0,0" 
        VerticalAlignment="Stretch" 
        HorizontalAlignment="Stretch" >
            <Grid  Margin="0,0,0,0" 
                   MaxWidth="{Binding ElementName=GridCupomFiscal,Path=ActualWidth}" 
                   MaxHeight="{Binding ElementName=GridCupomFiscal,Path=ActualHeight}"
                   >
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"></RowDefinition>
                    <RowDefinition Name="RowInfo" Height="92*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Name="GridCabec" Background="{x:Null}">
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0,0,0,4" Margin="0,0,0,10" BorderBrush="Blue" Grid.Row="0" Name="BorderTitulo" >
                        <Label Name="LabelTitulo" Content="Pedido de Venda Distribuição" FontSize="14" FontFamily="Gill Sans MT Condensed" Foreground="#FF1313D0" FontStretch="Condensed"></Label>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Name="GridInfo" HorizontalAlignment="Center" Background="{x:Null}" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Name="ColumnGridInfoList" Width="260"></ColumnDefinition>
                        <ColumnDefinition Name="ColumnGridInfoDados" Width="600"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid Name="Gridfiltros" Grid.Column="0" Width="250"  VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="180"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Width="250" HorizontalAlignment="Left"  Background="#FFA7A2A2">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <Grid Name="dtgridStackPainelfiltros" Width="250" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource _LabelSubInfoPrincipal}" ></Label>
                            </Grid>
                        </StackPanel>
                        <StackPanel Name="StackPainelFiltros" Grid.Row="1"  Orientation="Horizontal" Margin="0,5,0,0" HorizontalAlignment="Left">
                            <TabControl Background="{x:Null}" FontSize="9" >
                                <TabItem Background="{x:Null}" Header="Básicos" >
                                    <Grid >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25" ></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45"></ColumnDefinition>
                                            <ColumnDefinition Width="190"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Label  Margin="0,0,0,0"  FontSize="8" Style="{StaticResource _LabelDefault}">Vendedor</Label>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">

                                            <ComboBox VerticalAlignment="Top" ItemsSource="{Binding}"  IsEditable="False"  Margin="0,2,0,0"  Name="cmbVendedor" Height="20" FontSize="9" Style="{StaticResource _ComboBoxDefault}" >
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Name="NomeVendedor" Text="{Binding NomeVendedor}" Width="150"  ></TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Label   FontSize="8" Style="{StaticResource _LabelDefault}">Data</Label>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                    <ColumnDefinition Width="10*"></ColumnDefinition>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" Name="dtPickerIni" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" />
                                                <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                                <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" VerticalAlignment="Top" Name="dtPickerFim" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Label   FontSize="8" Style="{StaticResource _LabelDefault}">Código</Label>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="15*"></ColumnDefinition>
                                                    <ColumnDefinition Width="15*"></ColumnDefinition>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <TextBox  Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" Name="txtCdCliente" VerticalAlignment="Top" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right" MaxLength="5" />
                                                <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">Cliente</Label>
                                                <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" VerticalAlignment="Top" Name="txtNomeCliente" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right" MaxLength="40" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="3" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Label   FontSize="8" Style="{StaticResource _LabelDefault}">Fabricante</Label>
                                        </Border>
                                        <Border Grid.Row="4" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">

                                            <ComboBox VerticalAlignment="Top" ItemsSource="{Binding}"  IsEditable="False"  Margin="0,2,0,0"  Name="cmbfabricante" Height="20" FontSize="9" Style="{StaticResource _ComboBoxDefault}" >
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Name="DescricaoFabricante" Text="{Binding DescricaoFabricante}" Width="150"  ></TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                        </Border>


                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Grid>


                    <Grid Name="GridList" Grid.Column="1" Width="600"  VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="150"></RowDefinition>
                            <RowDefinition Height="200"></RowDefinition>
                            <RowDefinition Height="65"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Width="600" HorizontalAlignment="Right"  Background="#FFA7A2A2">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <Grid Name="dtgridStackPainelTitulolista" Width="600" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>


                                </Grid.ColumnDefinitions>
                                <Label Content="Rentabilidade " HorizontalAlignment="Left" Style="{StaticResource _LabelSubInfoPrincipal}" ></Label>
                                <Button Name="BtnReport" Margin="0,0,0,0" Grid.Column="12" HorizontalAlignment="Stretch"  Style="{StaticResource _ButtonStandard_Imprimir}" Height="20" Width="20" ></Button>
                                <Button Name="BtnBuscar" Margin="0,0,10,0" Grid.Column="13" HorizontalAlignment="Right"  Style="{StaticResource _ButtonStandard_Buscar}" Height="20" Width="20" Click="BtnBuscar_Click"></Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Name="StackPainelLista" 
                                    Orientation="Horizontal"
                                    HorizontalAlignment="center" 
                                    VerticalAlignment="Top"
                                    Margin="1,10,1,1"
                                    Width="600" MaxWidth="600"  Height="140">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <DataGrid Name="DataGridPedido" MaxWidth="600" MinWidth="600" HorizontalAlignment="Stretch"  SelectionChanged="DataGridPedido_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn IsReadOnly="True"  Width="50" Header="Pedido" Binding="{Binding NumeroPedido}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="45" Header="Vend" Binding="{Binding CodigoVendedor}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="100" Header="Vendedor" Binding="{Binding NomeVendedor}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="110" Header="Cliente" Binding="{Binding NomeCliente}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="70" Header="Valor" Binding="{Binding ValorPedido, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="55" Header="% Bruta" Binding="{Binding MargemBruta, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn IsReadOnly="True"  Width="55" Header="% Aplic" Binding="{Binding MargemAplicada, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn IsReadOnly="True"  Width="55" Header="% Liq" Binding="{Binding MargemLiquida, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="Detalhes">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Name="cmdDetalhesItens" Style="{StaticResource _ButtonStandard_Detalhes}" Height="10" Width="10" Click="cmdDetalhesItens_Click"></Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>


                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Name="StackPainelDetalhes" 
                                    Orientation="Horizontal"
                                    HorizontalAlignment="center" 
                                    VerticalAlignment="Top"
                                    Margin="1,1,1,1"
                                    MinWidth="600" Width="600" MaxWidth="600"  Height="200">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <TabControl Background="{x:Null}" HorizontalAlignment="Stretch" FontSize="9" Height="201" Width="600">
                                <TabItem Header="Pedido" Background="{x:Null}">
                                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,0" Width="590"
                                DataContext="{Binding ElementName=DataGridPedido, Path=SelectedItem}" 
                                Language="Br-Pt"
                                Background="{x:Null}">
                                        <Grid  Name="GridForm" Margin="5,5,5,5" Background="{x:Null}" >
                                            <Grid.RowDefinitions>
                                                <RowDefinition ></RowDefinition>
                                                <RowDefinition></RowDefinition>
                                                <RowDefinition></RowDefinition>
                                                <RowDefinition></RowDefinition>
                                                <RowDefinition></RowDefinition>
                                                <RowDefinition></RowDefinition>
                                                <RowDefinition></RowDefinition>
                                                <RowDefinition></RowDefinition>

                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" ></ColumnDefinition>
                                                <ColumnDefinition Width="140"> </ColumnDefinition>
                                                <ColumnDefinition Width="75" ></ColumnDefinition>
                                                <ColumnDefinition Width="50" ></ColumnDefinition>
                                                <ColumnDefinition Width="75" ></ColumnDefinition>
                                                <ColumnDefinition Width="50" ></ColumnDefinition>
                                                <ColumnDefinition Width="75" ></ColumnDefinition>
                                                <ColumnDefinition Width="50" ></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="White"/>
                                            <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,0,1" BorderBrush="White">
                                                <Label   Content="Informações Básicas" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Style="{StaticResource _LabelDefault}" ></Label>
                                            </Border>


                                            <Border Grid.Row="0" Grid.Column="2" BorderThickness="0,0,0,1" BorderBrush="White"/>
                                            <Border Grid.Row="0" Grid.Column="3" BorderThickness="0,0,0,1" BorderBrush="White">
                                                <Label   Content="Valor" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Style="{StaticResource _LabelDefault}" ></Label>
                                            </Border>

                                            <Border Grid.Row="0" Grid.Column="4" BorderThickness="0,0,0,1" BorderBrush="White"/>
                                            <Border Grid.Row="0" Grid.Column="5" BorderThickness="0,0,0,1" BorderBrush="White">
                                                <Label   Content="Margem" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Style="{StaticResource _LabelDefault}" ></Label>
                                            </Border>

                                            <Border Grid.Row="0" Grid.Column="6" BorderThickness="0,0,0,1" BorderBrush="White"/>
                                            <Border Grid.Row="0" Grid.Column="7" BorderThickness="0,0,0,1" BorderBrush="White">
                                                <Label   Content="Verba" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Style="{StaticResource _LabelDefault}" ></Label>
                                            </Border>





                                            <Label  Grid.Row="1" Grid.Column="0" Content="Cliente" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="2" Grid.Column="0" Content="Vendedor" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="3" Grid.Column="0" Content="Prazo" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="4" Content="Tipo Tabela" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="5" Grid.Column="0" Content="Status" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="6" Grid.Column="0" Content="Tipo Pedido" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>

                                            <Label  Grid.Row="1" Grid.Column="2" Content="Valor Base" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="2" Grid.Column="2" Content="Valor Tabela" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="3" Grid.Column="2" Content="-/+ Desc. Apl" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="4" Grid.Column="2" Content="(=) Vl. Aplicado" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="5" Grid.Column="2" Content="(-) Desc. Fin" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="6" Grid.Column="2" Content="(=) Valor Liq" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>


                                            <Label  Grid.Row="1" Grid.Column="4" Content="R$ Custo T." VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="2" Grid.Column="4" Content="% Bruta" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="3" Grid.Column="4" Content="% Financeira" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="4" Grid.Column="4" Content="% Aplicada" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="5" Grid.Column="4" Content="% Contrato" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="6" Grid.Column="4" Content="% Liquida" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>




                                            <Label  Grid.Row="1" Grid.Column="6" Content="Verba Vend." VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="2" Grid.Column="6" Content="Verba Forn." VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="3" Grid.Column="6" Content="% VV X Ped" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="4" Grid.Column="6" Content="% VF X Ped" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="5" Grid.Column="6" Content="" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="6" Grid.Column="6" Content="" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="5" Grid.Column="7" Content="" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="6" Grid.Column="7" Content="" VerticalAlignment="Bottom" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>


                                            <Label  Grid.Row="1" Grid.Column="1" Name="lblNomeCliente" Content="{Binding Path=NomeCliente}" VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="2" Grid.Column="1" Name="lblNomeVendedor" Content="{Binding Path=NomeVendedor}"  VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="3" Grid.Column="1" Name="lblPrazo" Content="{Binding Path=PrazoPagamento}" VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="4" Grid.Column="1" Name="lblTipoTabela" Content="{Binding Path=TipoTabela}"  VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="5" Grid.Column="1" Name="lblStatusPedido" Content="{Binding Path=StatusPedido}"  VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="6" Grid.Column="1" Name="lblTipoPedido" Content="{Binding Path=TipoPedido}"  VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>



                                            <Label  Grid.Row="1" Grid.Column="3" Name="lblValorBase" Content="{Binding Path=ValorFaturamentoBruto, StringFormat={}{0:N2}}" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="2" Grid.Column="3" Name="lblValorTabela" Content="{Binding Path=ValorFaturamento, StringFormat={}{0:N2}}"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="3" Grid.Column="3" Name="lblDescApl" Content="{Binding Path=ValorDescontoTotal, StringFormat={}{0:N2}}" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="4" Grid.Column="3" Name="lblValorAplicado" Content="{Binding Path=ValorFaturamentoAplicado, StringFormat={}{0:N2}}"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="5" Grid.Column="3" Name="lblDescFinanceiro" Content="{Binding Path=ValorDescontoFinanceiroTotal, StringFormat={}{0:N2}}"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="6" Grid.Column="3" Name="lblValorLiquido" Content="{Binding Path=ValorFaturamentoFinanceiro, StringFormat={}{0:N2}}"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>



                                            <Label  Grid.Row="1" Grid.Column="5" Name="lblCustoTotal" Content="{Binding Path=ValorCustoTotal, StringFormat={}{0:N2}}" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="2" Grid.Column="5" Name="lblMargemBruta" Content="{Binding Path=MargemBruta, StringFormat={}{0:N2}}"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="3" Grid.Column="5" Name="lblMargemFinanceira" Content="{Binding Path=MargemFinanceira, StringFormat={}{0:N2}}" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="4" Grid.Column="5" Name="lblMargemAplicada" Content="{Binding Path=MargemAplicada, StringFormat={}{0:N2}}"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
                                            <Label  Grid.Row="5" Grid.Column="5" Name="lblMargemFinanceiraAplicada" Content="{Binding Path=MargemAplicadaFinanceira, StringFormat={}{0:N2}}"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White"></Label>
