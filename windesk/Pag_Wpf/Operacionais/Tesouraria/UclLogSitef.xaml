<UserControl x:Class="Pag_Wpf.Operacionais.Tesouraria.UclLogSitef"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:DV="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"
             xmlns:DVC="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit" 
             xmlns:My="clr-namespace:Pag_Wpf.UserControls"
             mc:Ignorable="d" 
             Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Log Sitef</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="BtnBuscar_Click"></My:UclButton>
            <My:UclButton Grid.Column="2" x:Name="CMDReport" Text="Imprimir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Imprimir}" ImageClick="{StaticResource _ButtonImageBrush_Imprimir_Click}" Click="BtnReport_Click"></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GRIDInfo" Style="{StaticResource GridBase_Cabecalho}" MaxWidth="900" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="95*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>
                        <TabControl Grid.Row="1" Height="300" VerticalAlignment="Top">
                            <TabItem Header="Básicos">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"></ColumnDefinition>
                                        <ColumnDefinition Width="230"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label  Margin="0,0,0,0"  Style="{StaticResource _LabelDefault}">Op/E/Cp</Label>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*"></ColumnDefinition>
                                                <ColumnDefinition Width="30*"></ColumnDefinition>
                                                <ColumnDefinition Width="30*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"    ItemsSource="{Binding}"   Margin="1,1,1,1"  Name="cmbOperadores" Style="{StaticResource _ComboBoxDefault}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Name="NomeOperador" Text="{Binding NomeOperador}" Width="150"  ></TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding}"     Name="cmbECF"  Style="{StaticResource _ComboBoxDefault}" HorizontalAlignment="Left" Margin="1,1,1,1" Width="65">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Name="ECF" Text="{Binding ECF}" Width="25"  ></TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox  Grid.Column="1" Style="{StaticResource _TextBoxDefault}" Name="txtNumeroCupomFiscal" Grid.ColumnSpan="2" Margin="68,-1,4,-1" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label   Style="{StaticResource _LabelDefault}">Data</Label>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="10*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1"   HorizontalAlignment="Center" Name="dtPickerIni" VerticalAlignment="Center"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" />
                                            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                            <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1"   HorizontalAlignment="Center" VerticalAlignment="Center" Name="dtPickerFim" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Margin="0,0,0,0" Style="{StaticResource _LabelDefault}">Status</Label>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <ComboBox Style="{StaticResource _ComboBoxDefault}" VerticalAlignment="Top" ItemsSource="{Binding}" IsEditable="False" Margin="1,1,1,1" Name="cmbEstadoTransacao" >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Name="DescricaoSecao" Text="{Binding DescricaoSecao}" Width="150"></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                            <ComboBoxItem Content=" " />
                                            <ComboBoxItem Content="EFETUADA"  />
                                            <ComboBoxItem Content="NEGADA" />
                                            <ComboBoxItem Content="CANCELADA"  />
                                            <ComboBoxItem Content="AGUARDANDO"/>
                                            <ComboBoxItem Content="CANC.PDV" />
                                        </ComboBox>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label   Style="{StaticResource _LabelDefault}">Vl.Pgto</Label>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="10*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <TextBox  Grid.Row="0" Grid.Column="0" Name="txtvlPgtoIni" Style="{StaticResource _TextBoxDefault}" Margin="1,1,1,1" VerticalAlignment="Center"  HorizontalContentAlignment="Right" TextAlignment="Center" />
                                            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                            <TextBox Grid.Row="0" Grid.Column="2" Name="txtvlPgtoFim" Style="{StaticResource _TextBoxDefault}" Margin="1,1,1,1" VerticalAlignment="Center" HorizontalContentAlignment="Right" TextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver"></Border>
                                    <Border Grid.Row="4" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver"></Border>
                                </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>
            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" Name="DataGridLogSitef" Height="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn  IsReadOnly="True"  Header="Seq" Binding="{Binding SeqSitefLog}" Width="9*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True" Width="9*" Header="Produto" Binding="{Binding DescricaoProdutoFinanceiro}" ></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True" Width="9*" Header="Status" Binding="{Binding EstadoTransacao}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True" Width="9*" Header="Tipo" Binding="{Binding LogTipoTransacao}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True" Width="9*" Header="N.Cartao" Binding="{Binding CartaoReferencia}" ></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True" Width="9*" Header="Emissão" Binding="{Binding DataEmissao, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn  IsReadOnly="True" Width="9*" Header="Hora" Binding="{Binding DataHora, StringFormat=HH:mm:ss}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn  IsReadOnly="True" Width="9*" Header="ECF" Binding="{Binding Ecf}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn  IsReadOnly="True" Width="9*" Header="Cupom" Binding="{Binding CupomFiscal}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True" Width="9*"  Header="Valor" Binding="{Binding Valor, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True" Width="9*" Header="Cod.Aut" Binding="{Binding CodigoAutorizacao}" ></DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="cmdTransacaoRelacionada" Style="{StaticResource _ButtonStandard_Detalhes}" Height="10" Width="10" Click="cmdTransacaoRelacionada_Click"></Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="cmdImprimeTransacoes" Style="{StaticResource _ButtonStandard_Imprimir}" Height="10" Width="10" Click="cmdImprimeTransacoes_Click"></Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="1" Name="DataGridTransacaoRelacionada" Height="100" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="14*" IsReadOnly="True"  Header="Seq" Binding="{Binding SeqSitefLog}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="14*" IsReadOnly="True"  Header="Status" Binding="{Binding EstadoTransacao}"></DataGridTextColumn>
                            <DataGridTextColumn Width="14*" IsReadOnly="True"  Header="N.Cartao" Binding="{Binding CartaoReferencia}"></DataGridTextColumn>
                            <DataGridTextColumn Width="14*" IsReadOnly="True"  Header="Hora" Binding="{Binding DataHora, StringFormat='HH:mm:ss'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="14*" IsReadOnly="True"  Header="Valor" Binding="{Binding Valor, StringFormat={}{0:N2}}" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="14*" IsReadOnly="True"  Header="NSU" Binding="{Binding LogNSUHost}"></DataGridTextColumn>
                            <DataGridTextColumn Width="14*" IsReadOnly="True"   Header="Cod.Aut" Binding="{Binding CodigoAutorizacao}"></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Name="GRIDFolter">
        </Grid>
    </Grid>
</UserControl>