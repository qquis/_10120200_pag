<UserControl x:Class="Pag_Wpf.Operacionais.Expedicao.Entrada.UclNotasFiscais"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:My="clr-namespace:Pag_Wpf.UserControls"
             
      mc:Ignorable="d" 
         Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Registros Excepcionais Consolidados</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="BtnBuscar_Click"  ></My:UclButton>
            <My:UclButton Grid.Column="2" x:Name="CMDReport" Text="Imprimir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Imprimir}" ImageClick="{StaticResource _ButtonImageBrush_Imprimir_Click}" IsEnabled="True" Click="BtnReport_Click"></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GRIDInfo" Style="{StaticResource UclGridInfo}"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="95*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>


                        <TabControl Grid.Row="1" Height="350" VerticalAlignment="Top">
                                <TabItem Header="Básicos" >
                                    <Grid >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35" ></RowDefinition>
                                            <RowDefinition Height="35"></RowDefinition>
                                            <RowDefinition Height="35"></RowDefinition>
                                            <RowDefinition Height="35"></RowDefinition>
                                            <RowDefinition Height="35"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"></ColumnDefinition>
                                            <ColumnDefinition Width="290"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" >
                                            <Label   FontSize="8" Style="{StaticResource _LabelDefault}">Data</Label>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" >
                                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="135"></ColumnDefinition>
                                                    <ColumnDefinition Width="15"></ColumnDefinition>
                                                    <ColumnDefinition Width="135"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" Name="dtPickerIni" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0"  />
                                                <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                                <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" VerticalAlignment="Top" Name="dtPickerFim" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1"  />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Label  Style="{StaticResource _LabelDefault}">Fonercedor</Label>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <ComboBox Grid.Column="0"   VerticalAlignment="Stretch" ItemsSource="{Binding}"   Margin="0,0,0,0"  Name="cmbFornecedor" Style="{StaticResource _ComboBoxDefault}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Name="RazaoSocial" Text="{Binding RazaoSocialNome}" Width="150"  ></TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Label   Style="{StaticResource _LabelDefault}">Vl Nota</Label>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                    <ColumnDefinition Width="10*"></ColumnDefinition>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <TextBox  Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" Name="txtValorNotaIni" VerticalAlignment="Top" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right"  />
                                                <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                                <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" VerticalAlignment="Top" Name="txtValorNotaFim" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right"  />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="3" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Label   Style="{StaticResource _LabelDefault}">Nr Nota</Label>
                                        </Border>
                                        <Border Grid.Row="3" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <TextBox Margin="1,1,1,1" Height="20"  HorizontalAlignment="Stretch" VerticalAlignment="Top" Name="txtNumeroNota" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right"  />
                                        </Border>
                                        <Border Grid.Row="4" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Label   Style="{StaticResource _LabelDefault}">Tipo</Label>
                                        </Border>
                                        <Border Grid.Row="4" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Row="0" Grid.Column="0" Name="chkTipoNormal" IsChecked="True" Content="Normal"></CheckBox>
                                                <CheckBox Grid.Row="0" Grid.Column="1" Name="chkTipoBonificado" IsChecked="True" Content="Bonificado"></CheckBox>
                                            </Grid>


                                        </Border>
                                    </Grid>
                                </TabItem>
                            </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>

            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}" >

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"></RowDefinition>
                        <RowDefinition Height="150*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"  HorizontalAlignment="Stretch" Height="150"  Name="DataGridNotasFiscaisEntrada" >
                        <DataGrid.Columns>
                            <DataGridTextColumn IsReadOnly="True"  Width="75" Header="Data Recebimento" Binding="{Binding DataRecebimento,StringFormat=dd/MM/yyyy}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="75" Header="ERP Cod Forn" Binding="{Binding ErpCdFornecedor}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="150" Header="Razão Social" Binding="{Binding RazaoSocialEmissor}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="70" Header="Nota Fiscal" Binding="{Binding NumeroNotaFiscal}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="75" Header="Bonificada" Binding="{Binding NotaFiscalBonificada}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="90" Header="Valor" Binding="{Binding ValorNotaFiscal, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Detalhes">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="cmdNotasFiscais" Style="{StaticResource _ButtonStandard_Detalhes}" Height="10" Width="10" Click="cmdNotasFiscais_Click"></Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotaFiscalBonificada}" Value="SIM">
                                        <Setter Property="Foreground" Value="Red"></Setter>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>

                    <DataGrid Grid.Row="1" Name="DataGridItens" Height="150" Margin="1,5,1,1" >
                        <DataGrid.Columns>
                            <DataGridTextColumn IsReadOnly="True"  Width="125" Header="Descrição" Binding="{Binding Descricao}"></DataGridTextColumn>

                            <DataGridTextColumn IsReadOnly="True"  Width="40" Header="Código" Binding="{Binding CdProduto}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="40" Header="UN" Binding="{Binding EmbalagemEstoque}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="QtdeEst" Binding="{Binding QtdeEmbalagemEstoque}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn IsReadOnly="True"  Width="40" Header="UN Nf" Binding="{Binding EmbalagemNotaFiscal}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="QtdeNF" Binding="{Binding QtdeNotaFiscal}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn IsReadOnly="True"  Width="40" Header="UNCMP" Binding="{Binding EmbalagemCompra}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="FatorCmp" Binding="{Binding EmbalagemCompraFator}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>


                            <DataGridTextColumn IsReadOnly="True"  Width="60" Header="VlUnit" Binding="{Binding ValorUnitario}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="100" Header="Vl Total" Binding="{Binding ValorTotal}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>

                    </DataGrid>




                </Grid>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
