<UserControl x:Class="Pag_Wpf.Operacionais.Produto.UclProdutoInterfaceCusto"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:My="clr-namespace:Pag_Wpf.UserControls"
             
      mc:Ignorable="d" 
         Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Interface ERP - Custo</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="BtnBuscar_Click" ></My:UclButton>
            <My:UclButton Grid.Column="2" x:Name="CMImportar" Text="Importar " Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_SelecionaTudo}" ImageClick="{StaticResource _ButtonImageBrush_SelecionaTudo_Click}" IsEnabled="False" Click="CMImportar_Click"></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GRIDInfo" Style="{StaticResource UclGridInfo}"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="95*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>


                        <TabControl Grid.Row="1" Height="300" VerticalAlignment="Top">
                            <TabItem Header="Básicos" >
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35" ></RowDefinition>


                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"></ColumnDefinition>
                                        <ColumnDefinition Width="220"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" >
                                        <CheckBox Name="CHKDataCustoAtualizacao" Content="Data Atualização" Foreground="Black" HorizontalContentAlignment="Left"  FlowDirection="RightToLeft" Click="CHKDataCustoAtualizacao_Click"></CheckBox>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" >
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"></ColumnDefinition>
                                                <ColumnDefinition Width="10"></ColumnDefinition>
                                                <ColumnDefinition Width="105"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" Name="dtPickerIni" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" SelectedDateChanged="dtPickerIni_SelectedDateChanged" />
                                            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                            <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" Height="20"  HorizontalAlignment="Center" VerticalAlignment="Top" Name="dtPickerFim" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1" SelectedDateChanged="dtPickerFim_SelectedDateChanged" />
                                        </Grid>
                                    </Border>



                                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" >
                                        <Label Content="Descrição do Produto" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" >
                                        <TextBox    Name="txtdescricaoProduto" Style="{StaticResource _TextBoxDefault}" KeyboardNavigation.TabIndex="21" TextChanged="txtdescricaoProduto_TextChanged"></TextBox>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" >
                                        <Label  Margin="0,0,0,0"  FontSize="11" Style="{StaticResource _LabelDefault}" Visibility="Hidden">Departamento</Label>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1"  >
                                        <ComboBox   VerticalAlignment="Stretch" ItemsSource="{Binding}"  HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="cmbDepartamento" Height="20" Style="{StaticResource _ComboBoxDefault}" SelectionChanged="cmbDepartamento_SelectionChanged" Visibility="Hidden">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Name="DescricaoDepartamento" Text="{Binding DescricaoDepartamento}"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="0" Margin="0,0,0,0" >
                                        <Label  Margin="0,0,0,0"  FontSize="11" Style="{StaticResource _LabelDefault}" Visibility="Hidden">Seção</Label>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="1"  Margin="0,0,0,0" >
                                        <ComboBox      Name="cmbSecao"  Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="cmbSecao_SelectionChanged" Visibility="Hidden">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DescricaoSecao}"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="0" Margin="0,0,0,0" >
                                        <Label  Margin="0,0,0,0"  FontSize="11" Style="{StaticResource _LabelDefault}" Visibility="Hidden">Linha</Label>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="1"  Margin="0,0,0,0" >
                                        <ComboBox  Name="cmbLinha" Height="20" Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="cmbLinha_SelectionChanged" Visibility="Hidden">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DescricaoLinha}"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="0" Margin="0,0,0,0" >
                                        <Label  Margin="0,0,0,0"  FontSize="11" Style="{StaticResource _LabelDefault}" Visibility="Hidden">Produtos</Label>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="1" >
                                        <TextBox Name="txtcodigoproduto"  Style="{StaticResource _TextBoxDefault}" TextChanged="txtcodigoproduto_TextChanged" Visibility="Hidden"></TextBox>
                                    </Border>
                                    <Border Grid.Row="6" Grid.Column="0" Margin="0,0,0,0" >
                                        <Label  Margin="0,0,0,0"  FontSize="11" Style="{StaticResource _LabelDefault}" Visibility="Hidden">Fabricante</Label>
                                    </Border>
                                    <Border Grid.Row="6" Grid.Column="1"  Margin="0,0,0,0" >
                                        <ComboBox Name="cmbFabricante" Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="cmbFabricante_SelectionChanged" Visibility="Hidden">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Name="DescricaFabricante"  Text="{Binding Descricao}" Width="150" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>
            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}" Height="300" >
                    <DataGrid  Name="DTGProdutoCusto" Height="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn IsReadOnly="True"  Width="75" Header="Código" Binding="{Binding CdProduto}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="350" Header="Descrição" Binding="{Binding Descricao}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="75" Header="Data Atualizacao" Binding="{Binding DataAtualizacao,StringFormat=dd/MM/yyyy}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="75" Header="Seq Custo" Binding="{Binding SeqProdutoCusto}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="90" Header="Custo Faturamento" Binding="{Binding ValorCustoPadrao, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="90" Header="Custo Atual" Binding="{Binding ValorCustoPadraoAtual, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="80" Header="Data Custo" Binding="{Binding DataCusto,StringFormat=dd/MM/yyyy}"></DataGridTextColumn>



                        </DataGrid.Columns>
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotaFiscalBonificada}" Value="SIM">
                                        <Setter Property="Foreground" Value="Red"></Setter>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
