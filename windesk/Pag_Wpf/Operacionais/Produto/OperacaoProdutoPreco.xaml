<Page x:Class="Pag_Wpf.Operacionais.Produto.OperacaoProdutoPreco"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:DV="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"
      xmlns:DVC="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit" 
      mc:Ignorable="d" 
	Title="Produto - Aplicação de Preços">
    <Grid Name="GridOperacionalProdutoVinculo" >
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Name="RowInfo" Height="600"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GridBase_Cabecalho_Border}" Name="BorderTitulo" >
            <Grid Grid.Row="0" Name="GridCabec" Style="{StaticResource GridBase_Cabecalho}">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"></ColumnDefinition>
                    <ColumnDefinition Width="200"></ColumnDefinition>
                    <ColumnDefinition Width="50"></ColumnDefinition>
                    <ColumnDefinition Width="200"></ColumnDefinition>
                    <ColumnDefinition Width="50"></ColumnDefinition>
                    <ColumnDefinition Width="200"></ColumnDefinition>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                    <ColumnDefinition Width="180"></ColumnDefinition>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                    <ColumnDefinition Width="20*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Name="LabelTitulo"  Style="{StaticResource GridBase_Cabecalho_LabelTitulo}">Aplicação de Preços</Label>

                <Label  Grid.Column="1" Grid.Row="0" Foreground="White" HorizontalAlignment="Right" >Importação de Preços ERP</Label>
                <Button Grid.Column="2" Name="CMImportar" HorizontalAlignment="Left"  Style="{StaticResource _ButtonStandard_SelecionaTudo}" Height="20" Width="20" ToolTip="Importação de Preços do ERP MOINHO " Margin="0,8,4,8"  Click="CMImportar_Click" IsEnabled="False"></Button>

                <Label  Grid.Column="3" Grid.Row="0" Foreground="White"  HorizontalAlignment="Right"  >Exportação de Preços</Label>
                <Button Grid.Column="4" Name="CMDAplicar"  HorizontalAlignment="Left"  Style="{StaticResource _ButtonStandard_Sair}" Height="20" Width="20" ToolTip="Exportar preços aplicados ao Sistema MOINHO" Margin="0,11,0,5" Click="CMDAplicar_Click" IsEnabled="False"></Button>
                <Label  Grid.Column="5" Grid.Row="0" Foreground="White" HorizontalAlignment="Right" >Atualizar</Label>
                <Button Grid.Column="6" Name="CMDAtualizar"  HorizontalAlignment="Right"  Style="{StaticResource _ButtonStandard_Buscar}" Width="20" Click="CMDAtualizar_Click" Margin="0,8"/>
                <Label  Grid.Column="7" Foreground="White" HorizontalAlignment="Right">Editar</Label>
                <Button Grid.Column="8" Name="CmdEditar" HorizontalAlignment="Stretch"  Style="{StaticResource _ButtonStandard_Editar}" Height="20" Width="20" Click="CmdEditar_Click" Margin="5,8,5,0" VerticalAlignment="Top"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Name="GridList" Width="1270" VerticalAlignment="Top" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="ColumnGridInfoList"  Width="260"></ColumnDefinition>
                <ColumnDefinition Name="ColumnGridInfoDados" Width="1010"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Name="Gridfiltros" VerticalAlignment="Top" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition Height="535"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Stretch"  Background="#FFA7A2A2">
                    <StackPanel.BitmapEffect>
                        <DropShadowBitmapEffect></DropShadowBitmapEffect>
                    </StackPanel.BitmapEffect>
                    <Grid Name="dtgridStackPainelfiltros"  HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource _LabelSubInfoPrincipal}" ></Label>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Name="StackPainelFiltros" Orientation="Horizontal" Margin="0,5,0,0" HorizontalAlignment="Stretch">
                    <TabControl>
                        <TabItem Header="Básicos" >
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35"></RowDefinition>
                                    <RowDefinition Height="35"></RowDefinition>
                                    <RowDefinition Height="35"></RowDefinition>
                                    <RowDefinition Height="35"></RowDefinition>
                                    <RowDefinition Height="35"></RowDefinition>
                                    <RowDefinition Height="35"></RowDefinition>

                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"></ColumnDefinition>
                                    <ColumnDefinition Width="180"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" HorizontalAlignment="Stretch" >
                                    <Label    Style="{StaticResource _LabelFormInfo}">Data</Label>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" >
                                    <DatePicker Name="DTPDataAplicacao" Width="150" HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Right" SelectedDateChanged="DTPDataAplicacao_SelectedDateChanged" IsEnabled="False"></DatePicker>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" >
                                    <Label  Style="{StaticResource _LabelFormInfo}">Operação</Label>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" >
                                    <ComboBox Grid.Row="1" Grid.Column="0" Name="CmbOperacao" Height="20"  Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="CmbOperacao_SelectionChanged" IsEnabled="False">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DescricaoOperacao}"  ></TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>

                                <Label Grid.Row="2"  Style="{StaticResource _LabelFormInfo}">Entrada</Label>
                                <Label Grid.Row="3"  Style="{StaticResource _LabelFormInfo}">Status</Label>
                                <Label Grid.Row="3" Grid.Column="1" Style="{StaticResource _LabelFormInfo}">Apenas Alterados</Label>
                                <Border Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" >

                                    <CheckBox Name="CHKDataCustoInicial"   HorizontalContentAlignment="Stretch" FlowDirection="RightToLeft"   Click="CHKDataCustoInicial_Click" Checked="CHKDataCustoInicial_Checked"></CheckBox>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" >
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker Name="DTPCustoInicial" Width="95"  Grid.Column="0" Grid.Row="1" HorizontalContentAlignment="Right" SelectedDateChanged="DTPCustoInicial_SelectedDateChanged"></DatePicker>
                                        <DatePicker Name="DTPCustoFinal" Width="95" HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Right" SelectedDateChanged="DTPCustoFinal_SelectedDateChanged" ></DatePicker>
                                    </Grid>
                                </Border>



                                <Border Grid.Row="3" Grid.Column="1" Margin="0,0,0,0" >
                                    <CheckBox Name="CHKAlteracaoPendente" HorizontalContentAlignment="Stretch" FlowDirection="RightToLeft" Click="CHKAlteracaoPendente_Click"></CheckBox>
                                </Border>




                            </Grid>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition Height="400"></RowDefinition>
                    <RowDefinition Height="35"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="1"  Margin="0,0,0,0" Background="#FFA7A2A2">
                    <Grid Grid.Column="0" HorizontalAlignment="Stretch" >
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"></ColumnDefinition>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="125"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="150"></ColumnDefinition>
                            <ColumnDefinition Width="70"></ColumnDefinition>
                            <ColumnDefinition Width="70"></ColumnDefinition>
                            <ColumnDefinition Width="160"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>


                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Fabricante" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="1" Content="Departamento" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="2" Content="Seção" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="3" Content="Linha" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="4" Content="Descrição" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="5" Content="Cd Tgt" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="6" Content="Cd Blue" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="7" Content="Operação Selecionada" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="8" Content="Data de Aplicação" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <ComboBox Grid.Row="1" Grid.Column="0" Name="cmbFabricante" Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="cmbFabricante_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="DescricaFabricante"  Text="{Binding Descricao}" Width="250" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="1"  VerticalAlignment="Stretch" ItemsSource="{Binding}"  HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="cmbDepartamento" Height="20" Style="{StaticResource _ComboBoxDefault}" SelectionChanged="cmbDepartamento_SelectionChanged" LostFocus="cmbDepartamento_LostFocus">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="DescricaoDepartamento" Text="{Binding DescricaoDepartamento}"  ></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="2"     Name="cmbSecao"  Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="cmbSecao_SelectionChanged" LostFocus="cmbSecao_LostFocus">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DescricaoSecao}"  ></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="3" Name="cmbLinha" Height="20" Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="cmbLinha_SelectionChanged" IsEnabled="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DescricaoLinha}"  ></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Row="1" Grid.Column="4"   Name="txtdescricaoProduto" Margin="5,0,5,0" Style="{StaticResource _TextBoxDefault}" KeyboardNavigation.TabIndex="21" TextChanged="txtdescricaoProduto_TextChanged"></TextBox>
                        <TextBox Grid.Row="1" Grid.Column="5" Name="txtcodigoproduto" Margin="5,0,5,0"  Style="{StaticResource _TextBoxDefault}" TextChanged="txtcodigoproduto_TextChanged"></TextBox>
                        <TextBox Grid.Row="1" Grid.Column="6" Name="txtcodigoprodutoBlue" Margin="5,0,5,0"  Style="{StaticResource _TextBoxDefault}"  TextChanged="txtcodigoprodutoBlue_TextChanged" ></TextBox>
                        <Label Grid.Row="1" Grid.Column="7" Name="LBLOperacaoSelecionada" HorizontalAlignment="Right" FontSize="12"></Label>
                        <Label Grid.Row="1" Grid.Column="8" Name="LBLAplicacaoSelecionada" HorizontalAlignment="Right" FontSize="12"></Label>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Name="StackPainelLista" Orientation="Horizontal" >
                    <StackPanel.BitmapEffect>
                        <DropShadowBitmapEffect></DropShadowBitmapEffect>
                    </StackPanel.BitmapEffect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="740"></ColumnDefinition>
                            <ColumnDefinition Width="270"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Row="1" Margin="2,2,2,6"  Name="DataGridProdutoPreco"     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionChanged="DataGridProdutoPreco_SelectionChanged" FontSize="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn IsReadOnly="True"  Width="45" Header="Prod." Binding="{Binding CdProduto}" FontSize="10">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="290" Header="Descricao" Binding="{Binding Descricao}" FontSize="10"/>
                                <DataGridTextColumn IsReadOnly="True"  Width="25" Header="UN" Binding="{Binding EmbalagemEstoque}"/>
                                <DataGridTextColumn IsReadOnly="True"  Width="60" Header="Preço" Binding="{Binding EmbalagemEstoquePreco, StringFormat={}{0:N2}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn IsReadOnly="True"  Width="60" Header="C.Ult Ent" Binding="{Binding ValorCusto, StringFormat={}{0:N2}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="45" Header="M%" Binding="{Binding Margem, StringFormat={}{0:N2}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="60" Header="C.Médio" Binding="{Binding ValorCustoFaturamento, StringFormat={}{0:N2}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="50" Header="V%" Binding="{Binding ValorVariacaoCusto, StringFormat={}{0:N2}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="50" Header="Estoque" Binding="{Binding ValorEstoque, StringFormat={}{0:N2}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Width="16">
                                                <Image.Style>
                                                    <Style TargetType="{x:Type Image}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AplicacaoPendente}" Value="False">
                                                                <Setter Property="Source" Value="C:\\TI\\TEMPPAG\\LegendaAzul.gif"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AplicacaoPendente}" Value="True">
                                                                <Setter Property="Source" Value="C:\\TI\\TEMPPAG\\LegendaAmarelo.gif"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>
                            </DataGrid.Columns>


                        </DataGrid>
                        <TabControl Grid.Column="1" HorizontalAlignment="Stretch">
                            <TabItem Header="Embalagens">
                                <Grid Grid.Column="1" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="5*"></RowDefinition>
                                        <RowDefinition Height="40*"></RowDefinition>
                                        <RowDefinition Height="5*"></RowDefinition>
                                        <RowDefinition Height="40*"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Name="STKEmbalagem"  Orientation="Horizontal" HorizontalAlignment="Stretch" Background="#FFA7A2A2" >
                                        <StackPanel.BitmapEffect>
                                            <DropShadowBitmapEffect></DropShadowBitmapEffect>
                                        </StackPanel.BitmapEffect>
                                        <Label HorizontalAlignment="Left" FontSize="12" Style="{StaticResource _LabelSubInfoPrincipal}" >Preços</Label>
                                    </StackPanel>
                                    <DataGrid Grid.Row="1"  Name="DataGridEmbalagemPreco" Margin="0,0,0,0"   HorizontalAlignment="Stretch" >
                                        <DataGrid.Columns>
                                            <DataGridTextColumn IsReadOnly="True"  Width="40" Header="" Binding="{Binding Embalagem}"/>
                                            <DataGridTextColumn IsReadOnly="True"  Width="50" Header="Preço" Binding="{Binding ValorPreco, StringFormat={}{0:N2}}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn IsReadOnly="True"  Width="50" Header="Custo" Binding="{Binding ValorCusto, StringFormat={}{0:N2}}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn IsReadOnly="True"  Width="50" Header="M%" Binding="{Binding Margem, StringFormat={}{0:N2}}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Row="2" Name="STKCB"  Orientation="Horizontal" HorizontalAlignment="Stretch" Background="#FFA7A2A2" >
                                        <StackPanel.BitmapEffect>
                                            <DropShadowBitmapEffect></DropShadowBitmapEffect>
                                        </StackPanel.BitmapEffect>
                                        <Label HorizontalAlignment="Left" FontSize="12" Style="{StaticResource _LabelSubInfoPrincipal}" >Códigos de Barra</Label>
                                    </StackPanel>
                                    <DataGrid Grid.Row="4"  Name="DataGridEmbalagemCB"  HorizontalAlignment="Stretch" >
                                        <DataGrid.Columns>
                                            <DataGridTextColumn IsReadOnly="True"  Width="45" Header="" Binding="{Binding Embalagem}"/>
                                            <DataGridTextColumn IsReadOnly="True"  Width="150" Header="Código Barra" Binding="{Binding CdBarra, StringFormat={}{0}}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>


                                        </DataGrid.Columns>
                                    </DataGrid>


                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Name="StackPainelFooterGrid"   Orientation="Horizontal" HorizontalAlignment="Stretch"  Background="#FFA7A2A2">
                    <StackPanel.BitmapEffect>
                        <DropShadowBitmapEffect></DropShadowBitmapEffect>
                    </StackPanel.BitmapEffect>
                    <Grid  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="230" ></ColumnDefinition>
                            <ColumnDefinition  Width="100"></ColumnDefinition>
                            <ColumnDefinition  Width="100"></ColumnDefinition>
                            <ColumnDefinition  Width="100"></ColumnDefinition>
                            <ColumnDefinition  Width="100"></ColumnDefinition>
                            <ColumnDefinition  Width="100"></ColumnDefinition>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Grid.Column="0" Grid.Row="0"  HorizontalAlignment="Left" FontSize="12">Quantidade Itens/Margem Média</Label>
                        <Label Grid.Column="1" Grid.Row="0" Name="LBLQTDE_ITENS" HorizontalAlignment="Right" FontSize="12"></Label>
                        <Label Grid.Column="2" Grid.Row="0" Name="LBLMARGEM_MEDIA" HorizontalAlignment="Right" FontSize="12"></Label>

                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>

    