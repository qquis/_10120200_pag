<UserControl x:Class="Pag_Wpf.Operacionais.Produto.UclOperacaoProdutoRegistroPendentes"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:My="clr-namespace:Pag_Wpf.UserControls"
             
      mc:Ignorable="d" 
         Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" Width="930" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Registros Pendentes de Apuração</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CMDBuscar" Text="Registros Pendentes" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CMDBuscar_Click" ></My:UclButton>
            <My:UclButton Grid.Column="2" x:Name="CMDConsolidar" Text="Consolidar" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_SelecionaTudo}" ImageClick="{StaticResource _ButtonImageBrush_SelecionaTudo_Click}" Click="CMDConsolidar_Click"  ></My:UclButton>
            
        </Grid>
        <Grid Grid.Row="1" Name="GRIDInfo" Style="{StaticResource UclGridInfo}"  >
            <StackPanel Style="{StaticResource UclStackPainel}" >
                <DataGrid x:Name="DTGRegistrosConsolidar"  HorizontalAlignment="Stretch" Height="300" >
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Sequencial" Binding="{Binding Sequencial}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Produto" Binding="{Binding CdProduto}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="30*" Header="Descrição" Binding="{Binding Descricao}"/>
                        <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Emb" Binding="{Binding Embalagem}"/>
                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Qtde" Binding="{Binding Qtde}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="15*" Header="Tipo Registro" Binding="{Binding TipoRegistro}"/>
                        <DataGridTextColumn IsReadOnly="True"  Width="15*" Header="Origem" Binding="{Binding Lista}"/>
                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Data" Binding="{Binding DataRegistro, StringFormat=dd/MM/yyyy}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Name="GRIDR" Style="{StaticResource UclGridR}"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition  Width="100" ></ColumnDefinition>
                <ColumnDefinition  Width="100"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"></RowDefinition>
            </Grid.RowDefinitions>
            <Label Grid.Column="0" Grid.Row="0" Width="100" Margin="1,1,1,1" Content="Itens" HorizontalAlignment="Left" Style="{StaticResource _LabelFormInfo}"></Label>
            <Label Grid.Column="1" Grid.Row="0" Name="LblTotal" Width="100" Margin="1,1,1,1" Style="{StaticResource _LabelFormInfo}" HorizontalContentAlignment="Right">0,00</Label>
        </Grid>
    </Grid>
</UserControl>
