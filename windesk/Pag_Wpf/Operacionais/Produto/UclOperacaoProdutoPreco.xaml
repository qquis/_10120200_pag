<UserControl x:Class="Pag_Wpf.Operacionais.Produto.UclOperacaoProdutoPreco"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:DV="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"
             xmlns:DVC="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit" 
             xmlns:My="clr-namespace:Pag_Wpf.UserControls"
             mc:Ignorable="d" 
             Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60*"></ColumnDefinition>
                <ColumnDefinition Width="20*"></ColumnDefinition>
                <ColumnDefinition Width="20*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Produto - Aplicação de Preços</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CMDAtualizar" Text="Atualizar" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CMDAtualizar_Click"></My:UclButton>
            <My:UclButton Grid.Column="2" x:Name="CMDEditar" Text="Editar" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Editar}" ImageClick="{StaticResource _ButtonImageBrush_Editar_Click}" Click="CmdEditar_Click"></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GRIDInfo" Style="{StaticResource GridBase_Cabecalho}" MaxWidth="1000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="75*"></ColumnDefinition>
                <ColumnDefinition Width="25*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>
                        <TabControl Grid.Row="1" Height="300" VerticalAlignment="Top">
                            <TabItem Header="Básicos"  >
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>

                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*"></ColumnDefinition>
                                        <ColumnDefinition Width="60*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" HorizontalAlignment="Stretch" >
                                        <Label    Style="{StaticResource _LabelFormInfo}">Data</Label>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1"  >
                                        <DatePicker Name="DTPDataAplicacao"  HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Right" SelectedDateChanged="DTPDataAplicacao_SelectedDateChanged" IsEnabled="False"></DatePicker>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" >
                                        <Label  Style="{StaticResource _LabelFormInfo}">Operação</Label>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" >
                                        <ComboBox Grid.Row="1" Grid.Column="0" Name="CmbOperacao" Height="20"  Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="CmbOperacao_SelectionChanged" IsEnabled="False">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DescricaoOperacao}"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>
                                    <Label Grid.Row="2"  Style="{StaticResource _LabelFormInfo}">Entrada</Label>
                                    <Label Grid.Row="3"  Style="{StaticResource _LabelFormInfo}">Status</Label>
                                    <Label Grid.Row="3" Grid.Column="1" Style="{StaticResource _LabelFormInfo}">Apenas Alterados</Label>
                                    <Border Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" >

                                        <CheckBox Name="CHKDataCustoInicial"   HorizontalContentAlignment="Stretch" FlowDirection="RightToLeft"   Click="CHKDataCustoInicial_Click" Checked="CHKDataCustoInicial_Checked"></CheckBox>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" >
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition></ColumnDefinition>
                                                <ColumnDefinition></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Name="DTPCustoInicial" Width="95"  Grid.Column="0" Grid.Row="1" HorizontalContentAlignment="Right" SelectedDateChanged="DTPCustoInicial_SelectedDateChanged"></DatePicker>
                                            <DatePicker Name="DTPCustoFinal" Width="95" HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Right" SelectedDateChanged="DTPCustoFinal_SelectedDateChanged" ></DatePicker>
                                        </Grid>
                                    </Border>



                                    <Border Grid.Row="3" Grid.Column="1" Margin="0,0,0,0" >
                                        <CheckBox Name="CHKAlteracaoPendente" HorizontalContentAlignment="Stretch" FlowDirection="RightToLeft" Click="CHKAlteracaoPendente_Click"></CheckBox>
                                    </Border>




                                </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>
            <StackPanel Grid.Column="2"  Style="{StaticResource UclStackPainel}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*"></RowDefinition>
                        <RowDefinition Height="90*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,3">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12*"></ColumnDefinition>
                            <ColumnDefinition Width="12*"></ColumnDefinition>
                            <ColumnDefinition Width="12*"></ColumnDefinition>
                            <ColumnDefinition Width="12*"></ColumnDefinition>
                            <ColumnDefinition Width="12*"></ColumnDefinition>
                            <ColumnDefinition Width="12*"></ColumnDefinition>
                            <ColumnDefinition Width="12*"></ColumnDefinition>
                            <ColumnDefinition Width="12*"></ColumnDefinition>
                            <ColumnDefinition Width="12*"></ColumnDefinition>

                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Fabricante" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="1" Content="Departamento" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="2" Content="Seção" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="3" Content="Linha" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="4" Content="Descrição" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="5" Content="Cd Tgt" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="6" Content="Cd Blue" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="7" Content="Operação Selecionada" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <Label Grid.Row="0" Grid.Column="8" Content="Data de Aplicação" HorizontalAlignment="Right" FontSize="10" Foreground="Blue"></Label>
                        <ComboBox Grid.Row="1" Grid.Column="0" Name="cmbFabricante" Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="cmbFabricante_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="DescricaFabricante"  Text="{Binding Descricao}" Width="250" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="1"  VerticalAlignment="Stretch" ItemsSource="{Binding}"  HorizontalAlignment="Stretch" Margin="0,0,0,0"  Name="cmbDepartamento" Height="20" Style="{StaticResource _ComboBoxDefault}" SelectionChanged="cmbDepartamento_SelectionChanged" LostFocus="cmbDepartamento_LostFocus">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="DescricaoDepartamento" Text="{Binding DescricaoDepartamento}"  ></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="2"     Name="cmbSecao"  Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="cmbSecao_SelectionChanged" LostFocus="cmbSecao_LostFocus">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DescricaoSecao}"  ></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="3" Name="cmbLinha" Height="20" Style="{StaticResource _ComboBoxDefault}" ItemsSource="{Binding}" SelectionChanged="cmbLinha_SelectionChanged" IsEnabled="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DescricaoLinha}"  ></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Row="1" Grid.Column="4"   Name="txtdescricaoProduto" Margin="5,0,5,0" Style="{StaticResource _TextBoxDefault}" KeyboardNavigation.TabIndex="21" TextChanged="txtdescricaoProduto_TextChanged"></TextBox>
                        <TextBox Grid.Row="1" Grid.Column="5" Name="txtcodigoproduto" Margin="5,0,5,0"  Style="{StaticResource _TextBoxDefault}" TextChanged="txtcodigoproduto_TextChanged"></TextBox>
                        <TextBox Grid.Row="1" Grid.Column="6" Name="txtcodigoprodutoBlue" Margin="5,0,5,0"  Style="{StaticResource _TextBoxDefault}" TextChanged="txtcodigoprodutoBlue_TextChanged"></TextBox>
                        <Label Grid.Row="1" Grid.Column="7" Name="LBLOperacaoSelecionada" HorizontalAlignment="Right" FontSize="12"></Label>
                        <Label Grid.Row="1" Grid.Column="8" Name="LBLAplicacaoSelecionada" HorizontalAlignment="Right" FontSize="12"></Label>
                    </Grid>
                    <DataGrid Grid.Row="1" Name="DataGridProdutoPreco" SelectionChanged="DataGridProdutoPreco_SelectionChanged" Height="350" >
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True"  Width="45" Header="Prod." Binding="{Binding CdProduto}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="25*" Header="Descricao" Binding="{Binding Descricao}"/>
                        <DataGridTextColumn IsReadOnly="True"  Width="6*" Header="UN" Binding="{Binding EmbalagemEstoque}"/>
                        <DataGridTextColumn IsReadOnly="True"  Width="12*" Header="Preço" Binding="{Binding EmbalagemEstoquePreco, StringFormat={}{0:N2}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="12*" Header="Ult. Ent" Binding="{Binding ValorCusto, StringFormat={}{0:N2}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="M%" Binding="{Binding Margem, StringFormat={}{0:N2}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="12*" Header="Médio" Binding="{Binding ValorCustoFaturamento, StringFormat={}{0:N2}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="12*" Header="V%" Binding="{Binding ValorVariacaoCusto, StringFormat={}{0:N2}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn IsReadOnly="True"  Width="12*" Header="Estoque" Binding="{Binding ValorEstoque, StringFormat={}{0:N2}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="16">
                                        <Image.Style>
                                            <Style TargetType="{x:Type Image}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AplicacaoPendente}" Value="False">
                                                        <Setter Property="Source" Value="C:\\TI\\TEMPPAG\\LegendaAzul.gif"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AplicacaoPendente}" Value="True">
                                                        <Setter Property="Source" Value="C:\\TI\\TEMPPAG\\LegendaAmarelo.gif"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>
                    </DataGrid.Columns>


                </DataGrid>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*"></RowDefinition>
                        <RowDefinition Height="50*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="1"  Name="DataGridEmbalagemPreco" Height="150" >
                        <DataGrid.Columns>
                            <DataGridTextColumn IsReadOnly="True"  Width="40" Header="" Binding="{Binding Embalagem}"/>
                            <DataGridTextColumn IsReadOnly="True"  Width="50" Header="Preço" Binding="{Binding ValorPreco, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="50" Header="Custo" Binding="{Binding ValorCusto, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="50" Header="M%" Binding="{Binding Margem, StringFormat={}{0:N2}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Name="GRIDFolter" >
            <Grid  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition  Width="230" ></ColumnDefinition>
                    <ColumnDefinition  Width="100"></ColumnDefinition>
                    <ColumnDefinition  Width="100"></ColumnDefinition>
                    <ColumnDefinition  Width="100"></ColumnDefinition>
                    <ColumnDefinition  Width="100"></ColumnDefinition>
                    <ColumnDefinition  Width="100"></ColumnDefinition>

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"></RowDefinition>
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0"  HorizontalAlignment="Left" FontSize="12">Quantidade Itens/Margem Média</Label>
                <Label Grid.Column="1" Grid.Row="0" Name="LBLQTDE_ITENS" HorizontalAlignment="Right" FontSize="12"></Label>
                <Label Grid.Column="2" Grid.Row="0" Name="LBLMARGEM_MEDIA" HorizontalAlignment="Right" FontSize="12"></Label>

            </Grid>
        </Grid>
    </Grid>
</UserControl>