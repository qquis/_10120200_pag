<Page x:Class="Pag_Wpf.Operacionais.Varejo.SACFinanceiro"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
	Title="SAC Financeiro">
    <Grid Name="GridSACFinanceiro" >
        
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"></RowDefinition>
            <RowDefinition Name="RowInfo" Height="200*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GridCabec" Style="{StaticResource GridBase_Cabecalho}">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource GridBase_Cabecalho_Border}" Name="BorderTitulo" >
                <Label Name="LabelTitulo" Style="{StaticResource GridBase_Cabecalho_LabelTitulo}">SAC - Acompanhamento Financeiro</Label>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Name="GridInfo" Style="{StaticResource GridBase_Cabecalho}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="ColumnGridInfoList"  Width="360" ></ColumnDefinition>
                <ColumnDefinition Name="ColumnGridInfoDados" Width="920"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Name="Gridfiltros">
                  <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="430"></RowDefinition>
                        </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Background="#FFA7A2A2" Width="360">
                            <StackPanel.BitmapEffect>
                                <DropShadowBitmapEffect></DropShadowBitmapEffect>
                            </StackPanel.BitmapEffect>
                            <Grid Name="dtgridStackPainelfiltros" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label HorizontalAlignment="Left" Style="{StaticResource _LabelSubInfoPrincipal}" >Operador/ECF</Label>
                                <Button Grid.Column="1" Name="BtnOperadoresAtivos" Margin="0,0,0,0"  HorizontalAlignment="Right"  Style="{StaticResource _ButtonStandard_Buscar}" Height="20" Width="20" Click="BtnOperadoresAtivos_Click"></Button>
                            </Grid>
                        </StackPanel>
                  <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28" ></RowDefinition>
                                            <RowDefinition Height="350"></RowDefinition>
                                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"></ColumnDefinition>
                                                <ColumnDefinition Width="250"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" Style="{StaticResource _LabelDefault}">Data</Label>
                                            <DatePicker Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Name="dtPickerSelecao" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1" SelectedDateFormat="Long" />
                                        </Grid>
                        <DataGrid Grid.Row="1" Name="DataGridOperacaoAtiva" VerticalAlignment="Stretch">
                                 <DataGrid.Columns>
                                                <DataGridTextColumn IsReadOnly="True" Width="140" Header="Nome Operador" Binding="{Binding NomeOperador}"></DataGridTextColumn>
                                                <DataGridTextColumn IsReadOnly="True" Width="40"  Header="ECF" Binding="{Binding ECF}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Header="">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Name="cmdOperacaoDetalhes" Style="{StaticResource _ButtonStandard_Detalhes}" Height="10" Width="10" Click="cmdOperacaoDetalhes_Click"></Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                 <DataGrid.CellStyle>
                                                <Style TargetType="{x:Type DataGridCell}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ExigeSangria}" Value="True">
                                                            <Setter Property="Foreground" Value="Red"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.CellStyle>
                            </DataGrid>
                  </Grid>
            </Grid>
            <Grid Grid.Column="1" Name="GridList" VerticalAlignment="Top" Margin="1,0,0,0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="430"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" Background="#FFA7A2A2">
                    <Grid Name="dtgridStackPainelTitulolista"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label HorizontalAlignment="Left" Style="{StaticResource _LabelSubInfoPrincipal}" >Informações Financeiras Apuradas</Label>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Name="StackPainelLista"  Orientation="Horizontal" VerticalAlignment="Top" Height="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100" ></RowDefinition>
                            <RowDefinition Height="280"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,0" HorizontalAlignment="Stretch" Width="910">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="600"></ColumnDefinition>
                                <ColumnDefinition Width="150"></ColumnDefinition>
                                <ColumnDefinition Width="150"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition ></RowDefinition>
                                <RowDefinition ></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label  Grid.Row="0" Grid.Column="0" Name="lblNomeOperadorx" Content="Operador(a)" VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                            <Label  Grid.Row="0" Grid.Column="1" Name="lblECFx" Content="ECF" VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                            <Label  Grid.Row="0" Grid.Column="2" Name="lblFaturamentoGeralx" Content="Atendimentos"  VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                            <Label  Grid.Row="1" Grid.Column="0" Name="lblNomeOperador" VerticalAlignment="Stretch" FontSize="12"  Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                            <Label  Grid.Row="1" Grid.Column="1" Name="lblECF"  VerticalAlignment="Stretch" FontSize="12" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                            <Label  Grid.Row="1" Grid.Column="2" Name="lblRegistros"  VerticalAlignment="Stretch" FontSize="12" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                        </Grid>
                        <TabControl Grid.Row="1" >
                                <TabItem Name="TabCItemRecebimentos" Header="Recebimentos Gerais" >
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition ></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Grid.Row="0" >
                                            <DataGrid Name="DataGridFinalizadora"  >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn IsReadOnly="True" Width="170" Header="Finalizadora" Binding="{Binding Finalizadora}"></DataGridTextColumn>
                                                    <DataGridTextColumn IsReadOnly="True" Width="150" Header="Valor Liquido" Binding="{Binding ValorLiquido, StringFormat={}{0:N2}}">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            </Border>
                                        <Grid Grid.Column="1" >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="170" ></RowDefinition>
                                                <RowDefinition Height="150"></RowDefinition>
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Name="TabCItemProdutoFinanceiro" Header="Produtos Financeiros">
                                    <Border>
                                        <DataGrid  Name="DataGridProdutoFinanceiroItem">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn IsReadOnly="True"  Header="Produto" Binding="{Binding ProdutoFinanceiro}"></DataGridTextColumn>
                                                <DataGridTextColumn IsReadOnly="True"  Header="Valor Liquido" Binding="{Binding ValorLiquido, StringFormat={}{0:N2}}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </TabItem>
                                <TabItem Name="TabCItemProdutoFinalizadora" Header="Finalizadora X Prod. Financeiros">
                                    <Border Grid.Column="0" Grid.Row="2">
                                        <DataGrid  Name="DataGridProdutoFinanceiro"  >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn IsReadOnly="True"  Header="Finalizadora" Binding="{Binding Finalizadora}"></DataGridTextColumn>
                                                <DataGridTextColumn IsReadOnly="True"  Header="Produto" Binding="{Binding ProdutoFinanceiro}"></DataGridTextColumn>
                                                <DataGridTextColumn IsReadOnly="True"  Header="Valor Liquido" Binding="{Binding ValorLiquido, StringFormat={}{0:N2}}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </TabItem>
                                <TabItem Name="TabCItemDinheiro" Header="Operação em Dinheiro" >
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition ></ColumnDefinition>
                                                <ColumnDefinition ></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30"></RowDefinition>
                                                <RowDefinition Height="30"></RowDefinition>
                                                <RowDefinition Height="30"></RowDefinition>
                                                <RowDefinition Height="30"></RowDefinition>
                                                <RowDefinition Height="30"></RowDefinition>
                                                <RowDefinition Height="30"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Label  Grid.Row="0" Grid.Column="0" Content="Entrada" VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="1" Grid.Column="0" Content="Reforço" VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="2" Grid.Column="0" Content="Faturamento"  VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="3" Grid.Column="0" Content="Sangria"  VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="4" Grid.Column="0" Content="Saldo"  VerticalAlignment="Stretch" Style="{StaticResource _LabelDefault}" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                           
                                            <Label  Grid.Row="0" Grid.Column="1" Name="lblentrada" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" FontSize="10" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="1" Grid.Column="1" Name="lblreforco"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" FontSize="10" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="2" Grid.Column="1" Name="lblfaturamento"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" FontSize="10" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="3" Grid.Column="1" Name="lblsangria"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" FontSize="10" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                            <Label  Grid.Row="4" Grid.Column="1" Name="lblsaldo"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Style="{StaticResource _LabelDefault}" FontSize="10" BorderThickness="1,0,0,1" BorderBrush="White" ></Label>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Name="TabCItemGeral" Header="Operações Gerais">
                                <Border>
                                        <DataGrid Name="DataGridDetalhes">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn IsReadOnly="True" Width="120" Header="Finalizadora" Binding="{Binding Finalizadora}"/>
                                                <DataGridTextColumn IsReadOnly="True" Width="120" Header="Produto" Binding="{Binding ProdutoFinanceiro}"/>
                                                <DataGridTextColumn IsReadOnly="True" Width="100" Header="CupomFiscal" Binding="{Binding CupomFiscal}"/>
                                                <DataGridTextColumn IsReadOnly="True" Width="70" Header="Doc" Binding="{Binding CartaoReferencia}"/>
                                                <DataGridTextColumn IsReadOnly="True" Width="80" Header="Vl Rec" Binding="{Binding ValorRecebido, StringFormat={}{0:N2}}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn IsReadOnly="True"  Width="80" Header="Vl Dev" Binding="{Binding ValorDevolvido, StringFormat={}{0:N2}}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn IsReadOnly="True" Width="80" Header="Valor" Binding="{Binding Valor, StringFormat={}{0:N2}}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn  IsReadOnly="True" Width="80" Header="Canc" Binding="{Binding ValorCancelado, StringFormat={}{0:N2}}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn  IsReadOnly="True" Width="80" Header="Liquido" Binding="{Binding ValorLiquido, StringFormat={}{0:N2}}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </TabItem>
                            </TabControl>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
