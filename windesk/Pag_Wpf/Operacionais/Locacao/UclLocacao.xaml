<UserControl x:Class="Pag_Wpf.Operacionais.Locacao.UclLocacao"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:My="clr-namespace:Pag_Wpf.UserControls"
      mc:Ignorable="d" 
         Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Contratos de Locação de Ativo</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CMDBuscar_Click"></My:UclButton>
            <My:UclButton Grid.Column="2" x:Name="CMDIncluir" Text="Incluir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Incluir}" ImageClick="{StaticResource _ButtonImageBrush_Incluir_Click}" Click="CMDIncluir_Click"></My:UclButton>
            <My:UclButton Grid.Column="3" x:Name="CMDReport" Text="Imprimir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Imprimir}"  ></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GridInfo" Style="{StaticResource UclGridInfo}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="95*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>


                        <TabControl Grid.Row="1" Height="350" VerticalAlignment="Top">
                            <TabItem Header="Básicos" >
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>

                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"></ColumnDefinition>
                                        <ColumnDefinition Width="180"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <CheckBox Name="CHKDataCadastro" Content="Cadastro" Click="CHKDataCadastro_Click"></CheckBox>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="10*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" HorizontalAlignment="Center" Name="DTPCAD_INI" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" SelectedDateChanged="DTPCAD_INI_SelectedDateChanged" />
                                            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                            <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Center" VerticalAlignment="Top" Name="DTPCAD_FIM" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1" SelectedDateChanged="DTPCAD_FIM_SelectedDateChanged" />
                                        </Grid>
                                    </Border>



                                    <Border Grid.Row="1" Grid.Column="0"   Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Operação" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1"  Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <ComboBox Grid.Column="1"   ItemsSource="{Binding}"   Margin="0,0,0,0"  Name="CMBOperacao" Style="{StaticResource _ComboBoxDefault}" >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock  Text="{Binding DescricaoOperacao}" Width="150"  ></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>

                                    <Border Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Descrição" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="TXTDESCRICAO" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right" TextChanged="TXTDESCRICAO_TextChanged" />
                                    </Border>


                                </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>

            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <DataGrid Name="DTGContratos" Grid.Row="0"  HorizontalAlignment="Stretch" Height="170" Margin="0,0,0,2" >
                        <DataGrid.Columns>
                            <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Código" Binding="{Binding SeqContrato}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Empresa" Binding="{Binding Empresa}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Descrição" Binding="{Binding Descricao}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Tipo" Binding="{Binding Tipo}"></DataGridTextColumn>
                            <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Data Contrato" Binding="{Binding DataContrato, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn  Width="5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="CMDDetalhe" Style="{StaticResource _ButtonStandard_Detalhes}" Height="15" Width="15" Click="CMDDetalhe_Click" ></Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn  Width="5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="CMDAtivoEditar" Style="{StaticResource _ButtonStandard_Editar}" Height="15" Width="15" Click="CMDAtivoEditar_Click"  ></Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Height="30" DataContext="{Binding ElementName=DTGContratos, Path=SelectedItem}">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*"></ColumnDefinition>
                                <ColumnDefinition Width="70*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <My:UclLabelText Grid.Row="0" Grid.Column="0" x:Name="UclLabelTextCodigo" Caption="Código" Text="{Binding Path=SeqContrato}"  UclLabelWidth="100" UclTextWidth="335"  ></My:UclLabelText>
                            <My:UclLabelText Grid.Row="0" Grid.Column="1" x:Name="UclLabelTextDescricao" Caption="Descrição" Text="{Binding Path=Descricao}"  UclLabelWidth="100" UclTextWidth="335" ></My:UclLabelText>
                        </Grid>
                    </StackPanel>
                    <TabControl Grid.Row="2" Height="200">
                        <TabItem Header="Conteúdo">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80*"></ColumnDefinition>
                                    <ColumnDefinition Width="33*"/>
                                    <ColumnDefinition Width="123*"/>
                                    <ColumnDefinition Width="212*"/>
                                    <ColumnDefinition Width="448*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <My:UclLabelText Grid.Row="0" Grid.Column="0" x:Name="UTEmpresa" Text="{Binding Source=ContratoLocacaoSelecionado, Path=Empresa}" Caption="Empresa"  UclLabelWidth="100" UclTextWidth="300" Grid.ColumnSpan="4" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="1" Grid.Column="0" x:Name="UTCadastro" Caption="Cadastro"  UclLabelWidth="100" UclTextWidth="300" Grid.ColumnSpan="4" ></My:UclLabelText>

                                <My:UclLabelText Grid.Row="0" Grid.Column="4" x:Name="UTDataInicio" Caption="Data Inicial"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="1" Grid.Column="4" x:Name="UTDataFinal" Caption="Data Final"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>
                                <My:UclLabelText Grid.Row="2" Grid.Column="4" x:Name="UTValorTotal" Caption="Valor Total"  UclLabelWidth="100" UclTextWidth="300" ></My:UclLabelText>

                            </Grid>
                        </TabItem>
                        <TabItem Header="Participantes" IsEnabled="True">
                            <DataGrid Name="DTGContratoParticipante" Grid.Column="0" HorizontalAlignment="Stretch" Height="150" Width="800" VerticalAlignment="Top">
                                <DataGrid.Columns>
                                    <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Seq" Binding="{Binding SeqTipoContratoParticipante	}"/>
                                    <DataGridTextColumn IsReadOnly="True"  Width="40*" Header="Formato" Binding="{Binding TipoContratoPartipanteDescricao}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Código" Binding="{Binding CdParticipante}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="40*" Header="Nome" Binding="{Binding Nome}"></DataGridTextColumn>
                                    <DataGridTemplateColumn  Width="5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Name="CMDAtivoEditarItem" Style="{StaticResource _ButtonStandard_Editar}" Height="15" Width="15" Click="CMDAtivoEditarItem_Click"  ></Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        
                        
                        
                        

                        <TabItem Header="Rubricas" IsEnabled="True">
                            <DataGrid Name="DTGContratoRubricas"  HorizontalAlignment="Left" Height="150" Width="350"  VerticalAlignment="Top">
                                <DataGrid.Columns>
                                    <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Seq" Binding="{Binding SeqTipoContratoRubrica}"/>
                                    <DataGridTextColumn IsReadOnly="True"  Width="40*" Header="Rubrica" Binding="{Binding Descricao}"></DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Valor" Binding="{Binding Valor, StringFormat={}{0:N2}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn  Width="5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Name="CMDAtivoEditarRubrica" Style="{StaticResource _ButtonStandard_Editar}" Height="15" Width="15" Click="CMDAtivoEditarRubrica_Click"   ></Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Conf. Faturamento" IsEnabled="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="70"></RowDefinition>
                                    <RowDefinition Height="95"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45*"></ColumnDefinition>
                                    <ColumnDefinition Width="10*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <DataGrid Name="DTGContratoFaturamento"  HorizontalAlignment="Stretch" Height="70"  VerticalAlignment="Top">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Seq" Binding="{Binding SeqContratoLocacaoFaturamento}"/>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Venc." Binding="{Binding DiaVencimento}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="NumeroParcelas" Binding="{Binding NumeroParcelas}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Status" Binding="{Binding StatusContratoLocacaoFaturamento}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Data Inicial" Binding="{Binding DataInicial}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Registro" Binding="{Binding DataRegistro}"></DataGridTextColumn>
                                        <DataGridTemplateColumn  Width="5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Name="CMDDetalheParcelas" Style="{StaticResource _ButtonStandard_Detalhes}" Height="15" Width="15" Click="CMDDetalheParcelas_Click" ></Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions >
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <My:UclButton Grid.Row="0" x:Name="CMDIncluirContratoFaturamento" HorizontalAlignment="Right" Text="Incluir"  Height="30"   UclButtonMaxWidth="80"    ImageNoClick="{StaticResource _ButtonImageBrush_Incluir}" ImageClick="{StaticResource _ButtonImageBrush_Incluir_Click}" VerticalAlignment="Top" Click="CMDIncluirContratoFaturamento_Click"></My:UclButton>
                                    <My:UclButton Grid.Row="1" x:Name="CMDGerarParcelas" HorizontalAlignment="Right" Text="Gerar"  Height="30"   UclButtonMaxWidth="80"    ImageNoClick="{StaticResource _ButtonImageBrush_SelecionaTudo}" ImageClick="{StaticResource _ButtonImageBrush_Incluir_Click}" VerticalAlignment="Top" Click="CMDGerarParcelas_Click" ></My:UclButton>
                                </Grid>
                                
                            </Grid>
                                <DataGrid Name="DTGParcelas" Grid.Row="1" HorizontalAlignment="Stretch" Height="95"  VerticalAlignment="Top">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Seq" Binding="{Binding SeqContratoLocacaoParcelas}"/>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Ordem" Binding="{Binding NumeroOrdem}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Valor" Binding="{Binding Valor, StringFormat={}{0:N2}}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Dt Fat." Binding="{Binding DataFaturamento}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Venc" Binding="{Binding DataVencimento}"></DataGridTextColumn>
                                        <DataGridTemplateColumn  Width="5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Name="CMDAtivoEditarRubrica" Style="{StaticResource _ButtonStandard_Editar}" Height="15" Width="15" Click="CMDAtivoEditarRubrica_Click"   ></Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </Grid>
                        </TabItem>

                        <TabItem Header="Ativos" IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90*"></ColumnDefinition>
                                    <ColumnDefinition Width="10*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <DataGrid Name="DTGAtivoImobilizado" Grid.Column="0" HorizontalAlignment="Stretch" Height="150"  VerticalAlignment="Top">
                                <DataGrid.Columns>
                                    <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Ativo" Binding="{Binding SeqAtivoImobilizado	}"/>
                                    <DataGridTextColumn IsReadOnly="True"  Width="40*" Header="Descrição" Binding="{Binding DescricaoAtivoImobilizado}"></DataGridTextColumn>
                                        <DataGridTemplateColumn  Width="5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Name="CMDExcluirAtivoImobilizado" Style="{StaticResource _ButtonStandard_Excluir}" Height="15" Width="15" Click="CMDExcluirAtivoImobilizado_Click" ></Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                            </DataGrid>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions >
                                        <RowDefinition ></RowDefinition>
                                        <RowDefinition ></RowDefinition>
                                        <RowDefinition ></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <My:UclButton Grid.Row="0" x:Name="CMDIncluirAtivoImobilizado" HorizontalAlignment="Right" Text="Incluir"  Height="30"   UclButtonMaxWidth="80"    ImageNoClick="{StaticResource _ButtonImageBrush_Incluir}" ImageClick="{StaticResource _ButtonImageBrush_Incluir_Click}" VerticalAlignment="Top" Click="CMDIncluirAtivoImobilizado_Click" ></My:UclButton>
                                    
                                </Grid>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
    