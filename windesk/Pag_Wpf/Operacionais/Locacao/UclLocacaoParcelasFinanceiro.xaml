<UserControl x:Class="Pag_Wpf.Operacionais.Locacao.UclLocacaoParcelasFinanceiro"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:My="clr-namespace:Pag_Wpf.UserControls"
      mc:Ignorable="d" 
         Height="520" Width="1000">
    <Grid Name="GRIDBasic" Background="{StaticResource _BackGroundLinerGradientMain}" MaxHeight="510" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Name="RowCabec" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowDados" Height="Auto"></RowDefinition>
            <RowDefinition Name="RowFolter" Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Name="GRIDCabecalho"  Style="{StaticResource UclCabecalho}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label  Style="{StaticResource UclCabecalhoLabelPrincipal}" >Locação - Financeiro</Label>
            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
            <My:UclButton Grid.Column="1" x:Name="CMDBuscar" Text="Exibir Registros" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Buscar}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" Click="CMDBuscar_Click"></My:UclButton>
            <My:UclButton Grid.Column="3" x:Name="CMDReport" Text="Imprimir" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_Imprimir}"  ></My:UclButton>
        </Grid>
        <Grid Grid.Row="1" Name="GridInfo" Style="{StaticResource UclGridInfo}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="95*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Expander Grid.Column="0" ExpandDirection="Right" >
                <StackPanel Style="{StaticResource UclStackPainel}">
                    <Grid VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="365"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Content="Filtros" HorizontalAlignment="Left" Style="{StaticResource UclLabelFiltros}" ></Label>
                            <Rectangle Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource UclLinhaSubtitulo}"></Rectangle>
                        </Grid>


                        <TabControl Grid.Row="1" Height="350" VerticalAlignment="Top">
                            <TabItem Header="Básicos" >
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="35" ></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>
                                        <RowDefinition Height="35"></RowDefinition>

                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"></ColumnDefinition>
                                        <ColumnDefinition Width="180"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Vencimento" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="10*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Grid.Row="0" Grid.Column="0" Margin="1,1,1,1" HorizontalAlignment="Center" Name="DTPVENCIMENTO_INICIAL" VerticalAlignment="Top"  Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="0" SelectedDateChanged="DTPVENCIMENTO_INICIAL_SelectedDateChanged"  />
                                            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"  Style="{StaticResource _LabelDefault}">a</Label>
                                            <DatePicker Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Center" VerticalAlignment="Top" Name="DTPVENCIMENTO_FINAL" Style="{StaticResource _DatePickerDefault}" KeyboardNavigation.TabIndex="1" SelectedDateChanged="DTPVENCIMENTO_FINAL_SelectedDateChanged"  />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Desc. Contr" Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="TXTDESCRICAO" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right" TextChanged="TXTDESCRICAO_TextChanged" />
                                    </Border>


                                    <Border Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <Label Content="Seq. Contr." Grid.Row="1" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,1,1,1" BorderBrush="Silver">
                                        <TextBox Grid.Row="0" Grid.Column="2" Margin="1,1,1,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="TXTSEQCONTRATO" Style="{StaticResource _TextBoxDefault}" HorizontalContentAlignment="Right" TextChanged="TXTSEQCONTRATO_TextChanged"  />
                                    </Border>
                               </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </StackPanel>
            </Expander>

            <StackPanel Grid.Column="3"  Style="{StaticResource UclStackPainel}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80*"></ColumnDefinition>
                            <ColumnDefinition Width="20*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <DataGrid Name="DTGContratoFinanceiro" Grid.Row="0"  HorizontalAlignment="Stretch" Height="170"  >
                            <DataGrid.Columns>
                                <DataGridTextColumn IsReadOnly="True"  Width="5*" Header="Participante" Binding="{Binding CdParticipanteSacado}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="55*" Header="Locatário" Binding="{Binding NomeSacado}"></DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="15*" Header="Emissao" Binding="{Binding DataEmissao, StringFormat=dd/MM/yyyy}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Vencimento" Binding="{Binding DataVencimento, StringFormat=dd/MM/yyyy}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Valor" Binding="{Binding Valor, StringFormat={}{0:N2}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Saldo" Binding="{Binding ValorSaldo, StringFormat={}{0:N2}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn IsReadOnly="True"  Width="25*" Header="Situação" Binding="{Binding DescricaoSituacao}"></DataGridTextColumn>

                                <DataGridTemplateColumn  Width="5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Name="CMDDetalhe" Style="{StaticResource _ButtonStandard_Detalhes}" Height="15" Width="15"  Click="CMDDetalhe_Click" ToolTip="Exibe detalhes da parcela"></Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Name="CHKSelecionado" IsChecked="{Binding Path=SelecionadoParaExecucaoDeComando, Mode=TwoWay}" Click="CheckBox_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>



                        </DataGrid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="Comandos" Grid.Row="0" HorizontalContentAlignment="Left" Style="{StaticResource _LabelFormInfo}" />
                            <My:UclButton Grid.Row="1" x:Name="CMDTituloComandoLiquidar" Text="Liquidar Título" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_SelecionaTudo}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" HorizontalAlignment="Right" Click="CMDTituloComandoLiquidar_Click"></My:UclButton>
                            <My:UclButton Grid.Row="2" x:Name="CMDTituloComandoAbatimento" Text="Abatimento" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_SelecionaTudo}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" HorizontalAlignment="Right"></My:UclButton>
                            <My:UclButton Grid.Row="3" x:Name="CMDTituloComandoCancelar" Text="Cancelar" Height="30"  UclButtonMaxWidth="150"    ImageNoClick="{StaticResource _ButtonImageBrush_SelecionaTudo}" ImageClick="{StaticResource _ButtonImageBrush_Buscar_Click}" HorizontalAlignment="Right"></My:UclButton>
                        </Grid>

                    </Grid>
                    
                    <StackPanel Grid.Row="1" Height="30" DataContext="{Binding ElementName=DTGContratoFinanceiro, Path=SelectedItem}">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"></ColumnDefinition>
                                <ColumnDefinition Width="25*"></ColumnDefinition>
                                <ColumnDefinition Width="25*"></ColumnDefinition>
                                <ColumnDefinition Width="30*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <My:UclLabelText Grid.Row="0" Grid.Column="0" Caption="Locatário" Text="{Binding Path=NomeSacado}"  UclLabelWidth="80" UclTextWidth="300" ></My:UclLabelText>
                            <My:UclLabelText Grid.Row="0" Grid.Column="1" Caption="Título" Text="{Binding Path=SeqTítulo}"  UclLabelWidth="85" UclTextWidth="90"  ></My:UclLabelText>
                            <My:UclLabelText Grid.Row="0" Grid.Column="2" Caption="Venc." Text="{Binding Path=DataVencimento, StringFormat=dd/MM/yyyy}"  UclLabelWidth="50" UclTextWidth="130"  ></My:UclLabelText>
                            <My:UclLabelText Grid.Row="0" Grid.Column="3" Caption="Valor" Text="{Binding Path=Valor,StringFormat={}{0:N2}}"  UclLabelWidth="70" UclTextWidth="140"  ></My:UclLabelText>
                        </Grid>
                    </StackPanel>
                    <TabControl Grid.Row="2" Height="200">
                        <TabItem Header="Parcelas Associadas ao Título" IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <DataGrid Name="DTGContratoParcelas"  HorizontalAlignment="Left" Height="150" VerticalAlignment="Top">
                                   
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True"  Width="45*" Header="Descrição" Binding="{Binding DescricaoContrato}"></DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="10*" Header="Cod" Binding="{Binding SeqContratoLocacaoParcela}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="15*" Header="Parcela" Binding="{Binding NumeroOrdem}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="Valor" Binding="{Binding Valor, StringFormat={}{0:N2}}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="True"  Width="20*" Header="N. Faturam." Binding="{Binding SeqFaturamento}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                    </DataGrid.Columns>
                                </DataGrid>

                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
