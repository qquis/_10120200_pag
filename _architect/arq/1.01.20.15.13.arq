-------------- ANALIASE DA TABELA DE APURACAO DO COD_TRIBUTACAO_MERCADORIA---------

	insert into tbzanthustabtributacao_cod_tributacao
		(
				prbt_icms_saida_cst						
			,	prbt_icms_aliquota_interna				
			,	prbt_icms_reducao		
			,	processado 

		)
	SELECT 			prbt_icms_saida_cst
				,	prbt_icms_aliquota_interna
				,	prbt_icms_reducao  
				, 	0
	FROM 			TBPRODUTOBLUESOFT_TRIBUTACAO tr
	where  			TR.OP_CDOPERACAO = 2 
	AND				TR.PRBT_REGRAFISCAL_VERSAO = 99999
	group by 	prbt_icms_saida_cst
			,	prbt_icms_aliquota_interna
			,	prbt_icms_reducao 
			--,	cast(prbt_icms_aliquota_interna * (1 - (coalesce(prbt_icms_reducao,0)/100)) as numeric(13,2))
	order by 	prbt_icms_saida_cst
			,	prbt_icms_aliquota_interna
			,	prbt_icms_reducao


select  	icms_codigo_tributacao
		, 	icms_reducao
		, 	icms_aliquota
		, 	icms_aliquota_final 
from 		tbfc_regrafiscal_nfce_produto 
where pr_cdproduto = 43
