--select * from tab_tributacao_pdv
select M43AJ,* from zan_m43 where m00af='2025-12-17' and m00za=1 and m00ac=19
 SELECT cod_mercadoria, descricao,  cod_tributacao_mercadoria, percentual_reduz_b_calculo, aliquota_icms FROM tab_mercadoria WHERE COD_MERCADORIA  = '00000000000471619'
 BEGIN TRANSACTION;
 UPDATE tab_mercadoria
 SET    COD_TRIBUTACAO_MERCADORIA = 10 
     ,  PERCENTUAL_REDUZ_B_CALCULO = 8.3300
	 ,  ALIQUOTA_ICMS = 12 
	 ,  DESCRICAO = 'CAPA DE FILE-TST'
 WHERE COD_MERCADORIA  = '00000000000471619'

---SELECT cod_mercadoria, cst, aliquota, perc_reducao FROM tab_regras_icms  WHERE COD_MERCADORIA  = '00000000000471619' and flg_tipo_imposto = 0
UPDATE  tab_regras_icms
SET ALIQUOTA = 12
, PERC_REDUCAO = 8.33
, CST = 20
 WHERE COD_MERCADORIA  = '00000000000471619' and flg_tipo_imposto = 0
COMMIT 

