SCRIPT DE EXEMPLO DO UPDATE NO BANCO DE dados

BEGIN TRANSACTION;
UPDATE TAB_MERCADORIA 
SET COD_TRIBUTACAO_MERCADORIA = 10
  , COD_SITUACAO_TRIBUTARIA = '20'
  , ALIQUOTA_ICMS = NULL
WHERE COD_MERCADORIA IN ( '00000000000101801', '00000000000471619', '00000000000101792')


UPDATE TAB_REGRAS_ICMS
SET    	CST = '00'
	,	ALIQUOTA = 11
	,	PERC_REDUCAO = 0
WHERE COD_MERCADORIA IN ( '00000000000101801', '00000000000471619', '00000000000101792')
AND  FLG_TIPO_IMPOSTO = 0 
-- COMMIT








