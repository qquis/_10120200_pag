										  when '20' then '00'
										  when '40' then '40'
										  when '50' then '40'
										  when '60' then '60'
										  when '90' then '40'
										  else '00' end
							else 	
										  case repeat('0' , 2 - length(right(cast(coalesce(prbt_icms_saida_cst,'0') as char(3)),2))) || right(cast(coalesce(prbt_icms_saida_cst,'0') as char(3)),2) 
